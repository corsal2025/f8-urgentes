.DS_Store
.worktrees/

# .NET
bin/
obj/
*.user

# Secrets / environment-specific config
**/appsettings.Development.json
.env

# Runtime data (SQLite DB — contains real PII: names, RUTs, licencia data)
# NOTE: intentionally root-anchored (/data/*, not **/data/*) — a case-insensitive
# **/data/* pattern also matches src/F8Urgentes/Data/ and tests/.../Data/ on
# Windows (git's ignore matching is case-insensitive there by default), which
# would silently drop the whole Data layer from version control.
/data/*
!/data/*.example.csv
!/data/README.md
*.db

# OpenSpec local workset
openspec/.workset/
publish/
publish-pendrive/
imagenes/
.atl/

# Copia local de prueba del Excel matriz — contiene datos personales reales, nunca commitear
testdata/

# Temp build, logs, and run credentials
build-output.txt
build_log.txt
build_log_utf8.txt
build_verify.txt
cookies.txt
curl-cookies.txt
image.png
live_index.html
postbody.txt
token.txt
