<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>F8 Urgentes</title>
    <link rel="stylesheet" href="~/css/f8-dashboard.css" asp-append-version="true" />
</head>
<body class="cases-page">
    <header class="app-header">
        <div class="brand">
            <img src="~/img/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="brand-logo" />
            <span>
                F8 Urgentes
                <small>Municipalidad de Valparaíso<br />Solicitudes urgentes</small>
            </span>
        </div>
        <nav class="app-nav">
            <div class="nav-group">
                <a href="/Index">Solicitudes</a>
                <a href="/Edit">Nueva solicitud</a>
            </div>
            
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="nav-group" style="margin-left: auto;">
                    <span style="margin-right: 15px; font-size: 0.9rem; color: var(--color-text-muted);">
                        Hola, <strong>@User.Identity.Name</strong>
                    </span>
                    <a href="/Logout" style="color: #c0392b; font-weight: 500;">Salir</a>
                </div>
            }
        </nav>
    </header>
    <main>
        @RenderBody()
    <script>
        // Session Keep-Alive: sends a lightweight HEAD request every 5 minutes and on tab activation
        // to slide the 8-hour session cookie forward, preventing session expiration, white-page flashes,
        // or abrupt reloads when returning to an idle browser tab.
        (function() {
            function keepAlive() {
                if (document.visibilityState === 'visible') {
                    fetch('/Index', { method: 'HEAD', cache: 'no-store' }).catch(function() {});
                }
            }
            setInterval(keepAlive, 5 * 60 * 1000);
            document.addEventListener('visibilitychange', function() {
                if (document.visibilityState === 'visible') {
                    keepAlive();
                }
            });
        })();
    </script>
</body>
</html>
