<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>F8 Urgentes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Public+Sans:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/f8-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tema-lico.css" asp-append-version="true" />
</head>
<body class="cases-page">
    @{
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
        var headerSearch = Context.Request.Query["search"].ToString();
    }
    <div class="barra-nacion" aria-hidden="true"></div>
    <header class="app-header top">
        <div class="top-inner">
            <div class="top-brand-group">
                <a class="marca" href="/Index" title="Ir a Solicitudes">
                    <img src="~/img/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="brand-logo" />
                    <span class="marca-txt">
                        <span class="marca-org">Departamento de Licencias de Conducir</span>
                        <span class="marca-titulo">F8 Urgentes</span>
                    </span>
                </a>
                <div class="header-search" role="search">
                    <form method="get" action="/Index" class="header-search-form">
                        <div class="header-search-wrapper">
                            <svg class="header-search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                            <input type="text" name="search" id="headerSearchInput" value="@headerSearch" placeholder="Buscar por RUT o nombre..." autocomplete="off" aria-label="Buscar por RUT o nombre" />
                            @if (!string.IsNullOrEmpty(headerSearch))
                            {
                                <a class="header-search-clear" href="/Index" title="Limpiar búsqueda" aria-label="Limpiar búsqueda">✕</a>
                            }
                            else
                            {
                                <a class="header-search-clear" href="/Index" title="Limpiar búsqueda" aria-label="Limpiar búsqueda" style="display:none;">✕</a>
                            }
                        </div>
                    </form>
                </div>
            </div>

            <div class="top-right">
                <form method="post" asp-page="/Index" asp-page-handler="Sincronizar" class="header-sync-form">
                    <button class="tool-btn tool-sync header-sync-btn" type="submit" title="Trae casos 'NO HAY CARPETA' de la matriz y actualiza los ya subidos">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                        Sincronizar
                    </button>
                </form>

                <span class="head-lico-wrap">
                    <button id="head-lico" class="head-lico" type="button" aria-label="Lico tiene un consejo: pulsa para escucharlo" title="Lico tiene un consejo para ti"><span data-lico="saluda" aria-hidden="true"></span></button>
                    <div id="head-lico-burbuja" class="head-lico-burbuja" role="status" aria-live="polite" hidden></div>
                </span>
                <button id="lico-onoff" class="icono-btn" type="button" aria-pressed="true" title="Lico animado: activado (clic para desactivar)" aria-label="Lico animado: activado (clic para desactivar)">&#9786;</button>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="user-session-group">
                        <div class="user-pill">
                            <span class="user-avatar">@(string.IsNullOrEmpty(User.Identity.Name) ? "U" : User.Identity.Name.Substring(0, 1).ToUpper())</span>
                            <span class="user-name">@User.Identity.Name</span>
                        </div>
                        <a href="/Logout" class="btn-logout" title="Cerrar sesión">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                            Salir
                        </a>
                    </div>
                }
            </div>

            <nav class="app-nav" aria-label="Secciones">
                <a href="/Index" class="nav-solicitudes @(currentPage == "/Index" || currentPage == null ? "active" : "")">
                    <svg class="nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    Solicitudes
                </a>
                <a href="/Edit" class="nav-nueva @(currentPage == "/Edit" ? "active" : "")">
                    <svg class="nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    Nueva solicitud
                </a>
                <a href="/Caja" class="nav-caja @(currentPage == "/Caja" ? "active" : "")">
                    <svg class="nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8v13H3V8"></path><path d="M1 3h22v5H1z"></path><line x1="10" y1="12" x2="14" y2="12"></line></svg>
                    Caja
                </a>
                <a href="/CarpetasExtra" class="nav-extra @(currentPage == "/CarpetasExtra" ? "active" : "")">
                    <svg class="nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path><line x1="12" y1="11" x2="12" y2="17"></line><line x1="9" y1="14" x2="15" y2="14"></line></svg>
                    Carpetas Extra
                </a>
                <a href="/SinCarpetas" class="nav-sin @(currentPage == "/SinCarpetas" ? "active" : "")">
                    <svg class="nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/><line x1="9" y1="11" x2="15" y2="17"/><line x1="15" y1="11" x2="9" y2="17"/></svg>
                    Sin Carpetas
                </a>
            </nav>
        </div>
    </header>
    <main>
        @RenderBody()
    </main>
    <script>
        // Session Keep-Alive: sends a lightweight HEAD request every 5 minutes and on tab activation
        // to slide the 8-hour session cookie forward, preventing session expiration, white-page flashes,
        // or abrupt reloads when returning to an idle browser tab.
        (function() {
            function keepAlive() {
                if (document.visibilityState === 'visible') {
                    fetch('/Index', { method: 'HEAD', cache: 'no-store' }).catch(function() {});
                }
            }
            setInterval(keepAlive, 5 * 60 * 1000);
            document.addEventListener('visibilitychange', function() {
                if (document.visibilityState === 'visible') {
                    keepAlive();
                }
            });
        })();
    </script>
    <script src="~/js/lico.js" asp-append-version="true"></script>
    <script src="~/js/lico-juegos.js" asp-append-version="true"></script>
    <script src="~/js/lico-f8.js" asp-append-version="true"></script>
</body>
</html>
