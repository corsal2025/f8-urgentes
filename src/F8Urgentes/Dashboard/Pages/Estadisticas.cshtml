@page
@model F8Urgentes.Dashboard.Pages.EstadisticasModel
@using F8Urgentes.Dashboard.Charts
@{
    ViewData["Title"] = "Estadísticas";

    const string cSubida = "#059669";
    const string cPendiente = "#94a3b8";
    const string cIngreso = "#2563eb";
    const string cFuera = "#dc2626";

    var subidasPct = Model.Total > 0 ? Model.Subidas * 100.0 / Model.Total : 0;
    var plazoTotal = Model.PlazoDentro + Model.PlazoFuera;
    var plazoPct = plazoTotal > 0 ? Model.PlazoDentro * 100.0 / plazoTotal : 0;

    List<ChartSlice> ToSlices(IReadOnlyList<(string Label, int Count)> rows) =>
        rows.Select((r, i) => new ChartSlice(r.Label, r.Count, SvgCharts.Palette[i % SvgCharts.Palette.Length])).ToList();

    string Dias(double? d) => d is { } v ? v.ToString("0.#") : "—";
}

<partial name="_ToolNav" />

<div class="stats-scroll">
<h2 class="stats-section-title">Resumen</h2>
<div class="stats-grid">
    <div class="card stat-tile"><div class="stat-value">@Model.Total</div><div class="stat-label">Total de casos</div></div>
    <div class="card stat-tile stat-tile-ok"><div class="stat-value">@Model.Subidas</div><div class="stat-label">Subidas a CONASET</div></div>
    <div class="card stat-tile"><div class="stat-value">@Model.Pendientes</div><div class="stat-label">Pendientes</div></div>
    <div class="card stat-tile @(Model.PendientesVencidos > 0 ? "stat-tile-alert" : "")"><div class="stat-value">@Model.PendientesVencidos</div><div class="stat-label">Pendientes vencidos (+15 días hábiles)</div></div>
    <div class="card stat-tile @(plazoTotal > 0 && plazoPct < 80 ? "stat-tile-alert" : "stat-tile-ok")"><div class="stat-value">@(plazoTotal > 0 ? plazoPct.ToString("0") + "%" : "—")</div><div class="stat-label">Cumplimiento plazo legal</div></div>
    <div class="card stat-tile @(Model.PlazoFuera > 0 ? "stat-tile-alert" : "")"><div class="stat-value">@Model.PlazoFuera</div><div class="stat-label">Subidas fuera de plazo</div></div>
    <div class="card stat-tile"><div class="stat-value">@Dias(Model.TiempoPromedioConfirmacionDias)</div><div class="stat-label">Días promedio a subida</div></div>
    <div class="card stat-tile"><div class="stat-value">@Dias(Model.MedianaDiasConfirmacion)</div><div class="stat-label">Mediana días a subida</div></div>
    <div class="card stat-tile"><div class="stat-value">@Dias(Model.P90DiasConfirmacion)</div><div class="stat-label">P90 días a subida (9 de 10 casos)</div></div>
    <div class="card stat-tile @(Model.NeedsReview > 0 ? "stat-tile-alert" : "")"><div class="stat-value">@Model.NeedsReview</div><div class="stat-label">Requieren revisión</div></div>
    <div class="card stat-tile"><div class="stat-value">@Model.Marcados</div><div class="stat-label">Marcados (cola impresión)</div></div>
    <div class="card stat-tile"><div class="stat-value">@Model.PendienteCarpeta</div><div class="stat-label">Pendiente de carpeta</div></div>
</div>

<div class="chart-grid">
    <div class="card chart-card">
        <h3>Subidas vs. pendientes</h3>
        @SvgCharts.Pie([new("Subidas", Model.Subidas, cSubida), new("Pendientes", Model.Pendientes, cPendiente)],
            centerText: subidasPct.ToString("0") + "%", centerSub: "subidas")
    </div>
    <div class="card chart-card">
        <h3>Cumplimiento plazo legal (15 días hábiles)</h3>
        @SvgCharts.Pie([new("Dentro de plazo", Model.PlazoDentro, cSubida), new("Fuera de plazo", Model.PlazoFuera, cFuera)],
            centerText: plazoPct.ToString("0") + "%", centerSub: "a tiempo")
    </div>
</div>

<h2 class="stats-section-title">Tendencia</h2>
<div class="card chart-card">
    <h3>Ingresos vs. subidas por mes (últimos 12 meses)</h3>
    @SvgCharts.Grouped(Model.MensualIngresosSubidas.Select(m => m.MonthLabel).ToList(),
        [new ChartSeries("Ingresos (fecha citación)", cIngreso, Model.MensualIngresosSubidas.Select(m => (double)m.Ingresos).ToList()),
         new ChartSeries("Subidas a CONASET", cSubida, Model.MensualIngresosSubidas.Select(m => (double)m.Subidas).ToList())],
        w: 1280)
</div>

<div class="card chart-card">
    <h3>Ingresos por semana (fecha de citación)</h3>
    @SvgCharts.Line(Model.IngresosPorSemana.Select(w => (w.WeekLabel, (double)w.Count)).ToList(), cIngreso, w: 1280)
</div>

<div class="chart-grid">
    <div class="card chart-card">
        <h3>Cumplimiento de plazo por mes de subida</h3>
        @SvgCharts.Grouped(Model.CumplimientoPorMes.Select(m => m.MonthLabel).ToList(),
            [new ChartSeries("Dentro de plazo", cSubida, Model.CumplimientoPorMes.Select(m => (double)m.Dentro).ToList()),
             new ChartSeries("Fuera de plazo", cFuera, Model.CumplimientoPorMes.Select(m => (double)m.Fuera).ToList())],
            stacked: true)
    </div>
    <div class="card chart-card">
        <h3>Ingresos por día de la semana</h3>
        @SvgCharts.Bars(Model.IngresosPorDiaSemana.Select(d => (d.Label, (double)d.Count)).ToList(), cIngreso)
    </div>
</div>

<h2 class="stats-section-title">Tiempos</h2>
<div class="chart-grid">
    <div class="card chart-card">
        <h3>Histograma: días desde citación a subida</h3>
        @SvgCharts.Bars(Model.HistogramaDiasConfirmacion.Select(b => (b.BucketLabel, (double)b.Count)).ToList(),
            cIngreso, colorAt: i => i >= 3 ? cFuera : null, gapless: true)
        <p class="chart-hint">Rojo: tramos que suelen superar el plazo legal.</p>
    </div>
    <div class="card chart-card">
        <h3>Histograma: antigüedad de pendientes (días hábiles)</h3>
        @SvgCharts.Bars(Model.EnvejecimientoPendientes.Select(b => (b.BucketLabel, (double)b.Count)).ToList(),
            cPendiente, colorAt: i => Model.EnvejecimientoPendientes[i].Alert ? cFuera : null, gapless: true)
        <p class="chart-hint">Rojo: pendientes con plazo legal vencido.</p>
    </div>
</div>

<h2 class="stats-section-title">Carpetas físicas (Caja)</h2>
<div class="chart-grid chart-grid-2">
    <div class="card chart-card">
        <h3>Clasificación de carpetas</h3>
        @SvgCharts.Pie(
            [new("En caja cerrada", Model.ClasificacionCarpetas[0].Count, "#15803d"),
             new("En cola de caja", Model.ClasificacionCarpetas[1].Count, "#86efac"),
             new("Sin carpeta", Model.ClasificacionCarpetas[2].Count, "#64748b"),
             new("Sin clasificar", Model.ClasificacionCarpetas[3].Count, "#f59e0b")],
            centerText: Model.CajasCerradas.ToString(), centerSub: Model.CajasCerradas == 1 ? "caja cerrada" : "cajas cerradas")
    </div>
    <div class="card chart-card">
        <h3>Carpetas por caja cerrada</h3>
        @if (Model.CarpetasPorCaja.Count == 0)
        {
            <p class="empty-hint">Todavía no se ha cerrado ninguna caja.</p>
        }
        else
        {
            @SvgCharts.Bars(Model.CarpetasPorCaja.Select(c => (c.Code, (double)c.Count)).ToList(), "#15803d", unit: "carpeta(s)")
        }
    </div>
</div>

<h2 class="stats-section-title">Distribución</h2>
<div class="chart-grid chart-grid-2">
    <div class="card chart-card">
        <h3>Carga por sector oficina (subidas / pendientes)</h3>
        @SvgCharts.Grouped(Model.SectorOficinaEstado.Select(s => s.Label).ToList(),
            [new ChartSeries("Subidas", cSubida, Model.SectorOficinaEstado.Select(s => (double)s.Subidas).ToList()),
             new ChartSeries("Pendientes", cPendiente, Model.SectorOficinaEstado.Select(s => (double)s.Pendientes).ToList())],
            stacked: true)
    </div>
    <div class="card chart-card">
        <h3>Por sector oficina</h3>
        @SvgCharts.Pie(ToSlices(Model.PorSectorOficina))
    </div>
</div>
<div class="chart-grid chart-grid-2">
    <div class="card chart-card">
        <h3>Por estado</h3>
        @SvgCharts.Pie(ToSlices(Model.PorEstado))
    </div>
    <div class="card chart-card">
        <h3>Por estado actual</h3>
        @SvgCharts.Pie(ToSlices(Model.PorEstadoActual))
    </div>
    <div class="card chart-card">
        <h3>Por sector de archivo (penúltima carpeta)</h3>
        @SvgCharts.Pie(ToSlices(Model.PorSector))
    </div>
    <div class="card chart-card">
        <h3>Por origen del registro</h3>
        @SvgCharts.Pie(ToSlices(Model.PorOrigen))
    </div>
</div>
</div>
