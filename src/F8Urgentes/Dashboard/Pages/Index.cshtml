@page
@model F8Urgentes.Dashboard.Pages.IndexModel
@{
    ViewData["Title"] = "Solicitudes";
    var currentTab = Model.Tab ?? "Todos";
    var pendientesCount = Model.Requests.Count(r => string.IsNullOrWhiteSpace(r.EstadoActual) || r.EstadoActual.Equals("PENDIENTE", StringComparison.OrdinalIgnoreCase));
    var clearSearchQuery = new List<string>();
    if (!string.IsNullOrEmpty(currentTab) && currentTab != "Todos") clearSearchQuery.Add($"tab={Uri.EscapeDataString(currentTab)}");
    if (Model.Flagged == true) clearSearchQuery.Add("flagged=true");
    if (!string.IsNullOrEmpty(Model.Sort)) clearSearchQuery.Add($"sort={Uri.EscapeDataString(Model.Sort)}");
    if (!string.IsNullOrEmpty(Model.Rango)) clearSearchQuery.Add($"rango={Uri.EscapeDataString(Model.Rango)}");
    else
    {
        if (Model.FechaDesde is not null) clearSearchQuery.Add($"fechaDesde={Model.FechaDesde.Value:yyyy-MM-dd}");
        if (Model.FechaHasta is not null) clearSearchQuery.Add($"fechaHasta={Model.FechaHasta.Value:yyyy-MM-dd}");
    }
    var clearToolbarSearchHref = "/Index" + (clearSearchQuery.Count > 0 ? "?" + string.Join("&", clearSearchQuery) : "");
}

<style>
    .modern-modal {
        border: none;
        border-radius: 22px;
        box-shadow: 0 16px 48px rgba(16, 24, 40, 0.25);
        padding: 0;
        max-width: 820px;
        width: 95vw;
        background: var(--papel);
    }
    .modern-modal::backdrop {
        background: rgba(12, 17, 29, 0.5);
        backdrop-filter: blur(3px);
    }
    .modal-card {
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 1px solid var(--linea);
        padding-bottom: 12px;
    }
    .modal-title {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--azul-900);
    }
    .modal-subtitle {
        font-size: 0.8rem;
        color: var(--tinta-2);
    }
    .modal-close-btn {
        background: transparent;
        border: none;
        font-size: 1.1rem;
        color: var(--tinta-3);
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
    }
    .modal-close-btn:hover {
        background: var(--linea-2);
        color: var(--tinta);
    }
    .modal-rows-container {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-height: 50vh;
        overflow-y: auto;
        padding-right: 4px;
    }
    .modern-modal-row {
        display: grid;
        grid-template-columns: 2fr 1.3fr 1.1fr 1.2fr auto;
        gap: 10px;
        align-items: end;
        background: var(--elev);
        border: 1px solid var(--linea);
        border-radius: var(--r);
        padding: 10px;
    }
    .modern-modal-row .modal-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .modern-modal-row .modal-field label {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--tinta-3);
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }
    .modern-modal-row input {
        padding: 7px 10px;
        border: 1px solid var(--linea);
        border-radius: var(--r-sm);
        font-size: 0.82rem;
        font-family: inherit;
        background: var(--papel);
        color: var(--tinta);
    }
    .modern-modal-row input:focus {
        border-color: var(--azul);
        outline: none;
        box-shadow: 0 0 0 3px var(--ring);
    }
    .modal-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid var(--linea);
        padding-top: 14px;
        margin-top: 8px;
    }
    .modal-footer-actions {
        display: flex;
        gap: 8px;
    }
    .remove-row-btn {
        height: 34px;
        width: 34px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        border-radius: 50%;
        cursor: pointer;
    }
</style>

<section class="lico-hero" aria-labelledby="hero-title">
    <div class="hero-copy">
        <span class="hero-eyebrow">
            <span class="hero-status-dot" aria-hidden="true"></span>
            <span>LICENCIAS DE CONDUCIR / VALPARAÍSO</span>
        </span>
        <h1 id="hero-title">Cada solicitud,<br /><em>un F8 bajo control.</em></h1>
        <p class="hero-description">Gestiona, sincroniza y resguarda.<br />Tus solicitudes urgentes F8 y carpetas, en un solo lugar.</p>
        <div class="hero-actions">
            <form method="post" asp-page="/Index" asp-page-handler="Sincronizar">
                <button type="submit" class="btn btn-primary hero-sync-btn" title="Trae casos 'NO HAY CARPETA' de la matriz y actualiza los ya subidos">
                    <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m0 0-4 4m4-4 4 4M4 15v5h16v-5"/></svg>
                    <span>Cargar desde Excel</span>
                </button>
            </form>
            <a href="#mi-mesa" class="hero-mesa-link">Ir a mi mesa <span aria-hidden="true">↗</span></a>
        </div>
        <span class="hero-footnote">CON LICO, CADA EXPEDIENTE TIENE SU LUGAR.</span>
    </div>

    <div class="li-scene lico-stage" data-lico-espacio aria-label="El rincón de Lico">
        <div class="salvia-aura" aria-hidden="true"></div>
        <div class="salvia-plinth" aria-hidden="true"></div>
        <div class="li-figure li-mascot">
            <div class="li-mascot-stage">
                <button type="button" id="btn-lico-saludo" class="li-mascot-btn" data-lico-accion="saludar" aria-label="Saludar a Lico" aria-describedby="lico-espacio-ayuda">
                    <img src="~/img/lico/lico-licencia-3d.webp" alt="Lico, la pequeña licencia azul y blanca, con zapatos amarillos" width="768" height="512" />
                </button>
            </div>
        </div>
        <button type="button" class="lico-objeto lico-lampara" data-lico-accion="luz" aria-label="Luz de escritorio de Lico" aria-pressed="true">
            <span class="lico-lampara-dibujo" aria-hidden="true"><span class="lico-lampara-base"></span><span class="lico-lampara-brazo"></span><span class="lico-lampara-foco"></span></span>
            <span class="lico-objeto-etiqueta" data-lico-luz-etiqueta>Luz encendida</span>
        </button>
        <button type="button" class="lico-objeto lico-carpeta" data-lico-accion="pendientes" aria-label="Ver solicitudes en la mesa">
            <span class="lico-carpeta-dibujo" aria-hidden="true"><span class="lico-carpeta-hoja"></span><span class="lico-carpeta-tapa"></span><span class="lico-carpeta-sello">L</span></span>
            <span class="lico-objeto-etiqueta">Pendientes <b id="heroLicoCount">@pendientesCount</b></span>
        </button>
        <div class="studio-bubble lico-speech" id="licoSpeech">
            <p id="lico-studio-message" aria-live="polite">@(pendientesCount > 0 ? $"Tienes {pendientesCount} solicitud(es) pendientes en vista. Vamos paso a paso." : "¡Todo al día! Tus solicitudes en vista están gestionadas.")</p>
        </div>
        <span class="li-scene-caption lico-hint" id="lico-espacio-ayuda">TOCA A LICO · ABRE SU CARPETA · CAMBIA LA LUZ</span>
    </div>
</section>

<div class="studio-inbox-title" id="mi-mesa">
    <div>
        <span class="studio-kicker">GESTIÓN DIARIA</span>
        <h2>Tu mesa de solicitudes</h2>
    </div>
    <span id="studio-filter-label">@(currentTab == "Todos" ? "Todas las solicitudes" : currentTab)</span>
</div>

<div class="dashboard-controls">
    <div class="controls-row-main status-tabs-bar">
        <div class="filter-tabs-group status-tabs">
            <a href="@Model.BuildUrl(newTab: "Todos")" class="tab-pill @(currentTab == "Todos" ? "active" : "")">Todos</a>
            <a href="@Model.BuildUrl(newTab: "Pendientes")" class="tab-pill @(currentTab == "Pendientes" ? "active" : "")">Pendientes</a>
            <a href="@Model.BuildUrl(newTab: "Subidas")" class="tab-pill @(currentTab == "Subidas" ? "active" : "")">Subidas</a>
            <a href="@Model.BuildUrl(newTab: "Certificados")" class="tab-pill @(currentTab == "Certificados" ? "active" : "")">Solicitud de certificado</a>
            <a href="@Model.BuildUrl(newTab: "SinAgregar")" class="tab-pill @(currentTab == "SinAgregar" ? "active" : "")">
                Sin agregar
                @if (Model.SinAgregarCount > 0)
                {
                    <span class="badge tab-count-badge">@Model.SinAgregarCount</span>
                }
            </a>
            <a href="@Model.BuildUrl(newFlagged: Model.Flagged == true ? false : true)" class="tab-pill @(Model.Flagged == true ? "active" : "")">
                Requiere revisión
                @if (Model.FlaggedCount > 0)
                {
                    <span class="badge tab-count-badge tab-count-alert">@Model.FlaggedCount</span>
                }
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SyncMessage))
    {
        <div class="card alert-banner alert-success">
            @Model.SyncMessage
        </div>
    }

    @if (Model.DuplicateRuts.Count > 0)
    {
        <div class="card alert-banner alert-danger">
            ⚠ RUT duplicado(s), hay más de un caso con el mismo RUT: @string.Join(", ", Model.DuplicateRuts.Select(F8Urgentes.Domain.RutFormatter.WithDots))
        </div>
    }

    <div class="controls-row-actions toolbar-card">
        <div class="toolbar-left">
            <button type="button" class="btn-outline btn-open-modal toolbar-add-btn" id="open-quick-add-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Solicitudes sin agregar
            </button>

            <form method="get" action="/Index" class="toolbar-search-form" role="search">
                @if (!string.IsNullOrEmpty(currentTab) && currentTab != "Todos") { <input type="hidden" name="tab" value="@currentTab" /> }
                @if (Model.Flagged == true) { <input type="hidden" name="flagged" value="true" /> }
                @if (!string.IsNullOrEmpty(Model.Sort)) { <input type="hidden" name="sort" value="@Model.Sort" /> }
                @if (!string.IsNullOrEmpty(Model.Rango)) { <input type="hidden" name="rango" value="@Model.Rango" /> }
                @if (Model.FechaDesde is not null && string.IsNullOrEmpty(Model.Rango)) { <input type="hidden" name="fechaDesde" value="@Model.FechaDesde.Value.ToString("yyyy-MM-dd")" /> }
                @if (Model.FechaHasta is not null && string.IsNullOrEmpty(Model.Rango)) { <input type="hidden" name="fechaHasta" value="@Model.FechaHasta.Value.ToString("yyyy-MM-dd")" /> }
                <div class="toolbar-search-wrap">
                    <svg class="toolbar-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" name="search" id="toolbarSearchInput" value="@Model.Search" placeholder="Buscar por RUT o nombre..." autocomplete="off" aria-label="Buscar por RUT o nombre" />
                    <a class="toolbar-search-clear" href="@clearToolbarSearchHref" title="Limpiar búsqueda" aria-label="Limpiar búsqueda" style="@(string.IsNullOrEmpty(Model.Search) ? "display:none;" : "")">✕</a>
                </div>
                <button type="submit" class="toolbar-search-btn">Buscar</button>
            </form>
        </div>

        <div class="action-items-right">
            <span class="cases-count-badge toolbar-count-pill">@Model.Requests.Count caso(s)</span>
        </div>
    </div>
</div>

<dialog id="quick-add-modal" class="modern-modal">
    <div class="modal-card">
        <div class="modal-header">
            <div class="modal-title-wrap">
                <h3 class="modal-title">Solicitudes sin agregar</h3>
                <span class="modal-subtitle">Ingrese contribuyente(s) pendientes de incorporar al flujo</span>
            </div>
            <button type="button" class="modal-close-btn" id="close-quick-add-btn" title="Cerrar modal">✕</button>
        </div>
        <form method="post" asp-page-handler="AddManualCases" id="quick-add-form" class="modal-body">
            <div id="quick-add-rows" class="modal-rows-container">
                <div class="quick-add-row modern-modal-row">
                    <div class="modal-field">
                        <label>Nombre completo</label>
                        <input class="input-block" name="nombreCompleto" placeholder="ej: Gustavo Peña Castro" required />
                    </div>
                    <div class="modal-field modal-field-rut">
                        <label>RUT</label>
                        <input class="input-block rut-input" name="rut" placeholder="ej: 18.785.387-7" required />
                    </div>
                    <button type="button" class="btn-danger remove-row-btn" title="Quitar fila" hidden>×</button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="add-row-btn" class="btn-outline">+ Agregar otro</button>
                <div class="modal-footer-actions">
                    <button type="button" class="btn-secondary" id="cancel-quick-add-btn">Cancelar</button>
                    <button class="btn-primary" type="submit">Guardar caso(s)</button>
                </div>
            </div>
        </form>
    </div>
</dialog>

<div class="row-legend" aria-label="Leyenda de colores de las filas">
    <span class="row-legend-label">Colores de las filas:</span>
    <span class="row-legend-item"><span class="row-swatch swatch-uploaded" aria-hidden="true"></span>Subida a CONASET</span>
    <span class="row-legend-item"><span class="row-swatch swatch-marked" aria-hidden="true"></span>Marcada</span>
    <span class="row-legend-item"><span class="row-swatch swatch-nofolder" aria-hidden="true"></span>Sin carpeta</span>
    <span class="row-legend-item"><span class="row-swatch swatch-pending" aria-hidden="true"></span>Pendiente</span>
</div>

<div class="card table-card">
    <table class="cases cases-list">
        <thead>
            <tr>
                <th>Marcar</th>
                <th class="th-wrap">Nombre<br />contribuyente</th>
                <th>RUT</th>
                <th class="th-wrap">Sector<br />oficina</th>
                <th class="th-wrap">Código<br />F8</th>
                <th class="th-wrap">Fecha subida<br />F8</th>
                <th class="th-wrap">Estado<br />actual</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in Model.Requests)
            {
                <tr class="@(request.NeedsReview ? "row-needs-review" : "") @F8Urgentes.Dashboard.Pages.IndexModel.EstadoRowClass(request.Estado) @(request.EstadoActual == "SUBIDA A CONASET" || request.SinCarpeta ? "row-confirmed" : "")">
                    <td class="text-cell">
                        <form class="toggle-form" method="post" asp-page-handler="ToggleMarked">
                            <input type="hidden" name="id" value="@request.Id" />
                            <input type="checkbox" class="marked-checkbox" name="markedValue" value="on" checked="@request.Marked" title="Incluir en próxima impresión de sector" />
                        </form>
                    </td>
                    <td class="name-cell">
                        <input class="input-inline autosave" form="person-@request.Id" name="nombreCompleto" value="@request.NombreCompleto" placeholder="Nombre completo" />
                    </td>
                    <td class="rut-cell">
                        @{ var rutDisplay = F8Urgentes.Domain.RutFormatter.WithDots(request.Rut); }
                        <input class="input-inline autosave rut-input" form="person-@request.Id" name="rut" value="@rutDisplay" />
                        <form id="person-@request.Id" method="post" asp-page-handler="SetPersonData">
                            <input type="hidden" name="id" value="@request.Id" />
                        </form>
                    </td>
                    <td class="text-cell">@(request.MatrizSector ?? "—")</td>
                    <td class="text-cell">
                        <input class="input-inline autosave" form="codigof8-@request.Id" name="codigoF8" value="@request.CodigoF8" placeholder="Código F8" />
                        <form id="codigof8-@request.Id" method="post" asp-page-handler="SetCodigoF8">
                            <input type="hidden" name="id" value="@request.Id" />
                        </form>
                    </td>
                    <td class="text-cell fecha-subida-cell">@(request.FechaDeSubida?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td class="text-cell">
                        @{
                            var currentEstadoActual = string.IsNullOrEmpty(request.EstadoActual) ? "PENDIENTE" : request.EstadoActual;
                            var isLocked = currentEstadoActual == "SUBIDA A CONASET";
                        }
                        <select class="input-inline estado-actual-select @F8Urgentes.Dashboard.Pages.IndexModel.EstadoActualBadgeClass(request.EstadoActual)" form="estadoactual-@request.Id" name="estadoActual" disabled="@isLocked">
                            @if (currentEstadoActual != "CREAR CERTIFICADO")
                            {
                                <option value="@currentEstadoActual" selected>@currentEstadoActual</option>
                            }
                            <option value="CREAR CERTIFICADO" selected="@(currentEstadoActual == "CREAR CERTIFICADO")">CREAR CERTIFICADO</option>
                        </select>
                        <form class="toggle-form" id="estadoactual-@request.Id" method="post" asp-page-handler="SetEstadoActual">
                            <input type="hidden" name="id" value="@request.Id" />
                        </form>
                    </td>
                    <td class="action-cell">
                        <div class="action-group">
                            @if (request.EstadoActual != "SUBIDA A CONASET")
                            {
                                <form method="post" asp-page-handler="MarkUploaded">
                                    <input type="hidden" name="id" value="@request.Id" />
                                    <button class="btn-primary" type="submit" title="Marcar subida">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m18 15-6-6-6 6"/>
                                        </svg>
                                        <span>Subir</span>
                                    </button>
                                </form>
                            }
                            @if (request.SinCarpeta)
                            {
                                <form method="post" asp-page-handler="RevertSinCarpeta">
                                    <input type="hidden" name="id" value="@request.Id" />
                                    <button class="btn-folder btn-folder-revert" type="submit" title="Revertir Sin carpeta"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg><span>Revertir</span></button>
                                </form>
                            }
                            <form method="post" asp-page-handler="DeleteCase" onsubmit="return confirm('¿Eliminar esta solicitud?');">
                                <input type="hidden" name="id" value="@request.Id" />
                                <button class="btn-danger" type="submit" title="Eliminar">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        <line x1="10" y1="11" x2="10" y2="17"></line>
                                        <line x1="14" y1="11" x2="14" y2="17"></line>
                                    </svg>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    (function () {
        var scrollKey = 'f8-index-scroll';
        var table = document.querySelector('.card.table-card');
        var saved = sessionStorage.getItem(scrollKey);
        if (saved !== null) {
            sessionStorage.removeItem(scrollKey);
            try {
                var pos = JSON.parse(saved);
                window.scrollTo(0, pos.y || 0);
                if (table) {
                    table.scrollLeft = pos.x || 0;
                    table.scrollTop = pos.ty || 0;
                }
            } catch (err) { /* malformed value, skip restore */ }
        }
        document.addEventListener('submit', function () {
            sessionStorage.setItem(scrollKey, JSON.stringify({
                y: window.scrollY,
                x: table ? table.scrollLeft : 0,
                ty: table ? table.scrollTop : 0
            }));
        });
    })();

    // Modal behavior for Agregar Caso
    (function () {
        var modal = document.getElementById('quick-add-modal');
        var openBtn = document.getElementById('open-quick-add-btn');
        var closeBtn = document.getElementById('close-quick-add-btn');
        var cancelBtn = document.getElementById('cancel-quick-add-btn');

        function openModal() {
            if (!modal) return;
            if (typeof modal.showModal === 'function') {
                modal.showModal();
            } else {
                modal.setAttribute('open', '');
            }
            var firstInput = modal.querySelector('input[name="nombreCompleto"]');
            if (firstInput) setTimeout(function () { firstInput.focus(); }, 50);
        }

        function closeModal() {
            if (!modal) return;
            if (typeof modal.close === 'function') {
                modal.close();
            } else {
                modal.removeAttribute('open');
            }
        }

        if (openBtn) openBtn.addEventListener('click', openModal);
        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
        if (modal) {
            modal.addEventListener('click', function (e) {
                if (e.target === modal) closeModal();
            });
        }
    })();

    document.getElementById('quick-add-rows').addEventListener('click', function (event) {
        if (event.target.classList.contains('remove-row-btn')) {
            event.target.closest('.quick-add-row').remove();
        }
    });

    document.getElementById('add-row-btn').addEventListener('click', function () {
        var rows = document.getElementById('quick-add-rows');
        var row = document.createElement('div');
        row.className = 'quick-add-row modern-modal-row';
        row.innerHTML = '<div class="modal-field"><label>Nombre completo</label><input class="input-block" name="nombreCompleto" placeholder="ej: Gustavo Peña Castro" required /></div>' +
            '<div class="modal-field modal-field-rut"><label>RUT</label><input class="input-block rut-input" name="rut" placeholder="ej: 18.785.387-7" required /></div>' +
            '<button type="button" class="btn-danger remove-row-btn" title="Quitar fila">×</button>';
        rows.appendChild(row);
    });

    function submitToggle(form, onSuccess) {
        var formData = new FormData(form);
        fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function (response) {
            return response.json().catch(function () { return null; }).then(function (data) {
                return { ok: response.ok, status: response.status, data: data };
            });
        })
        .then(function (result) {
            if (!result.ok) {
                console.error('Toggle submit failed:', result.status);
            }
            if (onSuccess) {
                onSuccess(result.data, result.ok);
            }
        })
        .catch(function (err) {
            console.error('Toggle submit error:', err);
        });
    }

    // Marcar (amarillo) y Pendiente carpeta (morado) son mutuamente excluyentes. El color de fila
    // es puro CSS (:has(.marked-checkbox:checked)), reacciona solo con el checked nativo — lo único
    // que hace falta acá es desmarcar la otra casilla al tocar una, para que el CSS reaccione al
    // toque en vez de esperar el reload; el servidor ya lo garantiza igual (SetMarked/
    // SetPendienteCarpeta se limpian entre sí), esto solo evita que la casilla vieja se vea marcada
    // hasta que vuelva la respuesta.
    try {
        function wireExclusiveCheckbox(checkbox, siblingSelector) {
            checkbox.addEventListener('change', function () {
                var row = checkbox.closest('tr');
                var sibling = row ? row.querySelector(siblingSelector) : null;
                if (checkbox.checked && sibling) {
                    sibling.checked = false;
                }

                if (checkbox.form) {
                    submitToggle(checkbox.form, function (data, ok) {
                        if (!ok || !data || !row) return;
                        var markedBox = row.querySelector('input.marked-checkbox');
                        var pendienteBox = row.querySelector('input.pendiente-checkbox');
                        if (markedBox) markedBox.checked = !!data.marked;
                        if (pendienteBox) pendienteBox.checked = !!data.pendienteCarpeta;
                    });
                }
            });
        }

        document.querySelectorAll('input.marked-checkbox').forEach(function (checkbox) {
            wireExclusiveCheckbox(checkbox, 'input.pendiente-checkbox');
        });

        document.querySelectorAll('input.pendiente-checkbox').forEach(function (checkbox) {
            wireExclusiveCheckbox(checkbox, 'input.marked-checkbox');
        });
    } catch (err) {
        console.error('Marcar/Pendiente Carpeta wiring failed', err);
    }

    try {
        var estadoActualBadgeClasses = {
            'PENDIENTE': 'badge-pending',
            'SUBIDA A CONASET': 'badge-confirmed',
            'CREAR CERTIFICADO': 'badge-review'
        };

        document.querySelectorAll('select.estado-actual-select').forEach(function (select) {
            select.addEventListener('change', function () {
                Object.values(estadoActualBadgeClasses).forEach(function (cls) { select.classList.remove(cls); });
                select.classList.add(estadoActualBadgeClasses[select.value] || 'badge-review');

                var row = select.closest('tr');
                if (row) {
                    row.classList.toggle('row-confirmed', select.value === 'SUBIDA A CONASET');
                }

                var fechaCell = row ? row.querySelector('.fecha-subida-cell') : null;
                if (fechaCell) {
                    if (select.value === 'SUBIDA A CONASET') {
                        fechaCell.textContent = new Intl.DateTimeFormat('es-CL', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(new Date());
                    } else {
                        fechaCell.textContent = '—';
                    }
                }

                if (select.form) {
                    submitToggle(select.form, function (payload) {
                        if (payload && payload.fechaDeSubida && fechaCell) {
                            fechaCell.textContent = payload.fechaDeSubida;
                        }
                    });
                }
            });
        });
    } catch (err) {
        console.error('Estado actual dropdown wiring failed', err);
    }

    try {
        function formatRutInput(input) {
            function format(value) {
                var clean = value.replace(/[^0-9kK]/g, '').toUpperCase();
                if (clean.indexOf('K') >= 0) {
                    clean = clean.replace(/K/g, '') + (/[kK]\s*$/.test(value) ? 'K' : '');
                }
                clean = clean.slice(0, 9);
                if (clean.length < 7) {
                    return clean.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
                }
                var body = clean.slice(0, -1);
                var verifier = clean.slice(-1);
                return body.replace(/\B(?=(\d{3})+(?!\d))/g, '.') + '-' + verifier;
            }

            function formattedPosition(value, rawPosition) {
                if (rawPosition === 0) return 0;
                var seen = 0;
                for (var i = 0; i < value.length; i++) {
                    if (/[0-9K]/.test(value[i]) && ++seen === rawPosition) return i + 1;
                }
                return value.length;
            }

            var start = input.selectionStart;
            var end = input.selectionEnd;
            var rawStart = input.value.slice(0, start).replace(/[^0-9kK]/g, '').length;
            var rawEnd = input.value.slice(0, end).replace(/[^0-9kK]/g, '').length;
            var formatted = format(input.value);
            if (formatted !== input.value) {
                input.value = formatted;
                input.setSelectionRange(formattedPosition(formatted, rawStart), formattedPosition(formatted, rawEnd));
            }
        }

        document.addEventListener('input', function (event) {
            if (event.target.matches('input.rut-input')) formatRutInput(event.target);
        });

        document.querySelectorAll('input.rut-input').forEach(function (input) {
            formatRutInput(input);
            input.addEventListener('copy', function (event) {
                var selected = input.value.substring(input.selectionStart, input.selectionEnd);
                if (!selected) {
                    return;
                }
                event.clipboardData.setData('text/plain', selected.replace(/\./g, ''));
                event.preventDefault();
            });
        });
    } catch (err) {
        console.error('RUT copy wiring failed', err);
    }

    // Nombre, RUT y Código F8 save via fetch on blur, plus 'submit' as a
    // backstop in case a browser does implicit-submit the form. Enter is wired explicitly (not left
    // to rely on implicit submission): these inputs are associated to their <form> via the `form`
    // attribute rather than being DOM descendants of it, and confirmed live that some engines never
    // fire implicit submission for that case — Enter would silently do nothing. Forcing a blur()
    // reuses the already-working save path instead of duplicating it.
    try {
        var autosaveWiredForms = new WeakSet();
        document.querySelectorAll('input.autosave').forEach(function (input) {
            var form = input.form;
            if (!form) return;

            input.addEventListener('blur', function () {
                submitToggle(form);
            });

            input.addEventListener('keydown', function (event) {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    input.blur();
                }
            });

            if (!autosaveWiredForms.has(form)) {
                autosaveWiredForms.add(form);
                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    submitToggle(form);
                });
            }
        });
    } catch (err) {
        console.error('Autosave inputs wiring failed', err);
    }

    try {
        function updateStickyOffsets() {
            var table = document.querySelector('table.cases-list');
            if (!table) return;
            var ths = table.querySelectorAll('thead th');
            if (ths.length < 3) return;

            var w1 = ths[0].getBoundingClientRect().width;
            var w2 = ths[1].getBoundingClientRect().width;
            var left2 = w1.toFixed(2);
            var left3 = (w1 + w2).toFixed(2);

            table.style.setProperty('--sticky-col2', left2 + 'px');
            table.style.setProperty('--sticky-col3', left3 + 'px');

            var styleEl = document.getElementById('sticky-offsets-style');
            if (!styleEl) {
                styleEl = document.createElement('style');
                styleEl.id = 'sticky-offsets-style';
                document.head.appendChild(styleEl);
            }
            styleEl.textContent =
                'table.cases-list th:nth-child(1), table.cases-list td:nth-child(1) { left: 0px !important; position: sticky !important; z-index: 6 !important; border-right: none !important; box-shadow: none !important; }\n' +
                'table.cases-list th:nth-child(2), table.cases-list td:nth-child(2) { left: ' + left2 + 'px !important; position: sticky !important; z-index: 6 !important; border-right: none !important; box-shadow: none !important; }\n' +
                'table.cases-list th:nth-child(3), table.cases-list td:nth-child(3) { left: ' + left3 + 'px !important; position: sticky !important; z-index: 6 !important; border-right: none !important; box-shadow: none !important; }\n' +
                'table.cases-list thead th:nth-child(1), table.cases-list thead th:nth-child(2), table.cases-list thead th:nth-child(3) { z-index: 25 !important; background-color: var(--color-th-bg, #f3e8eb) !important; }';
        }
        window.addEventListener('DOMContentLoaded', updateStickyOffsets);
        window.addEventListener('load', updateStickyOffsets);
        window.addEventListener('resize', updateStickyOffsets);
        if (document.fonts) document.fonts.ready.then(updateStickyOffsets);
        setTimeout(updateStickyOffsets, 0);
        setTimeout(updateStickyOffsets, 80);
        setTimeout(updateStickyOffsets, 400);
    } catch (err) {
        console.error('Sticky offset calculation failed', err);
    }
</script>

<script>
    // RUT mask for search boxes (header and toolbar): when the text looks like a RUT (digits, dots, dash, K),
    // reformat as 12.345.678-9 while typing. Names are left untouched.
    (function () {
        function formatRut(value) {
            var clean = value.replace(/[.\-\s]/g, '').toUpperCase();
            if (clean.length < 2) return clean;
            var body = clean.slice(0, -1), dv = clean.slice(-1);
            return body.replace(/\B(?=(\d{3})+(?!\d))/g, '.') + '-' + dv;
        }
        function looksLikeRut(value) {
            return /^[\d.\-\s]*[\dkK]?$/.test(value) && /\d/.test(value);
        }
        function wireSearchBox(inputId, clearSelector) {
            var input = document.getElementById(inputId);
            if (!input) return;
            function updateClearBtn() {
                var clear = input.parentElement.querySelector(clearSelector);
                if (!clear) return;
                clear.style.display = input.value ? 'inline-flex' : 'none';
            }
            input.addEventListener('input', function () {
                var v = input.value;
                if (looksLikeRut(v)) {
                    var f = formatRut(v);
                    if (f !== v) {
                        input.value = f;
                        input.setSelectionRange(f.length, f.length);
                    }
                }
                updateClearBtn();
            });
            if (looksLikeRut(input.value)) input.value = formatRut(input.value);
            updateClearBtn();
        }
        wireSearchBox('headerSearchInput', '.header-search-clear');
        wireSearchBox('toolbarSearchInput', '.toolbar-search-clear');
    })();
</script>
