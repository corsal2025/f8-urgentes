@page
@model F8Urgentes.Dashboard.Pages.IndexModel
@{
    ViewData["Title"] = "Solicitudes";
    var currentTab = Model.Tab ?? "Todos";
}

<style>
    .modern-modal {
        border: none;
        border-radius: 12px;
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.35);
        padding: 0;
        max-width: 820px;
        width: 95vw;
        background: #ffffff;
    }
    .modern-modal::backdrop {
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(3px);
    }
    .modal-card {
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 12px;
    }
    .modal-title {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 700;
        color: #0f172a;
    }
    .modal-subtitle {
        font-size: 0.8rem;
        color: #64748b;
    }
    .modal-close-btn {
        background: transparent;
        border: none;
        font-size: 1.1rem;
        color: #94a3b8;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
    }
    .modal-close-btn:hover {
        background: #f1f5f9;
        color: #0f172a;
    }
    .modal-rows-container {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-height: 50vh;
        overflow-y: auto;
        padding-right: 4px;
    }
    .modern-modal-row {
        display: grid;
        grid-template-columns: 2fr 1.3fr 1.1fr 1.2fr auto;
        gap: 10px;
        align-items: end;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 10px;
    }
    .modern-modal-row .modal-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .modern-modal-row .modal-field label {
        font-size: 0.72rem;
        font-weight: 600;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }
    .modern-modal-row input {
        padding: 7px 10px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-size: 0.82rem;
        background: #ffffff;
        color: #0f172a;
    }
    .modern-modal-row input:focus {
        border-color: #2563eb;
        outline: none;
        box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.15);
    }
    .modal-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid #e2e8f0;
        padding-top: 14px;
        margin-top: 8px;
    }
    .modal-footer-actions {
        display: flex;
        gap: 8px;
    }
    .remove-row-btn {
        height: 34px;
        width: 34px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        border-radius: 6px;
        cursor: pointer;
    }
</style>

<div class="dashboard-controls">
    <div class="controls-row-main">
        <div class="filter-tabs-group">
            <a href="/Index?tab=Todos" class="tab-pill @(currentTab == "Todos" ? "active" : "")">Todos</a>
            <a href="/Index?tab=Pendientes" class="tab-pill @(currentTab == "Pendientes" ? "active" : "")">Pendientes</a>
            <a href="/Index?tab=Subidas" class="tab-pill @(currentTab == "Subidas" ? "active" : "")">Subidas</a>
            <a href="/Index?tab=Certificados" class="tab-pill @(currentTab == "Certificados" ? "active" : "")">Solicitud de certificado</a>
            <a href="/Index?tab=Penultimas" class="tab-pill @(currentTab == "Penultimas" ? "active" : "")">
                Penúltimas carpetas
                @if (Model.PenultimasCount > 0)
                {
                    <span class="badge badge-review">@Model.PenultimasCount</span>
                }
            </a>
            <a href="/Index?flagged=true" class="tab-pill @(Model.Flagged == true ? "active" : "")">
                Requiere revisión
                @if (Model.FlaggedCount > 0)
                {
                    <span class="badge badge-review">@Model.FlaggedCount</span>
                }
            </a>
        </div>

        <div class="tools-group">
            <a href="/SectorF8?sector=Archivo" class="tool-btn tool-archivo" title="PDF Archivo">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                Archivo
            </a>
            <a href="/SectorF8?sector=Oficina43" class="tool-btn tool-oficina43" title="PDF Oficina 43">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                Oficina 43
            </a>
            <a href="/Estadisticas" class="tool-btn tool-stats" title="Estadísticas">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                Estadísticas
            </a>
            <a href="/ImpresionMensual" class="tool-btn tool-print" title="Impresión mensual">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                Impresión mensual
            </a>
        </div>
    </div>

    @if (Model.ShowMonthlyPrintReminder)
    {
        <div class="card alert-banner alert-warning">
            <span>⚠ Recuerda imprimir las penúltimas carpetas de @Model.PreviousMonthKey.</span>
            <a href="/ImpresionMensual?month=@Model.PreviousMonthKey">Ir a impresión mensual</a>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SyncMessage))
    {
        <div class="card alert-banner alert-success">
            @Model.SyncMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.CertificadoMessage))
    {
        <div class="card alert-banner alert-success">
            @Model.CertificadoMessage
        </div>
    }

    @if (Model.DuplicateRuts.Count > 0)
    {
        <div class="card alert-banner alert-danger">
            ⚠ RUT duplicado(s), hay más de un caso con el mismo RUT: @string.Join(", ", Model.DuplicateRuts.Select(F8Urgentes.Domain.RutFormatter.WithDots))
        </div>
    }

    <div class="controls-row-actions">
        <div class="action-items-right">
            <span class="cases-count-badge">@Model.Requests.Count caso(s)</span>
            <button type="button" class="btn-primary btn-open-modal" id="open-quick-add-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Nueva solicitud
            </button>
        </div>
    </div>
</div>

<dialog id="quick-add-modal" class="modern-modal">
    <div class="modal-card">
        <div class="modal-header">
            <div class="modal-title-wrap">
                <h3 class="modal-title">Agregar nueva solicitud</h3>
                <span class="modal-subtitle">Ingrese contribuyente(s) para registrar en el sistema</span>
            </div>
            <button type="button" class="modal-close-btn" id="close-quick-add-btn" title="Cerrar modal">✕</button>
        </div>
        <form method="post" asp-page-handler="AddManualCases" id="quick-add-form" class="modal-body">
            <div id="quick-add-rows" class="modal-rows-container">
                <div class="quick-add-row modern-modal-row">
                    <div class="modal-field">
                        <label>Nombre completo</label>
                        <input class="input-block" name="nombreCompleto" placeholder="ej: Gustavo Peña Castro" required />
                    </div>
                    <div class="modal-field modal-field-rut">
                        <label>RUT</label>
                        <input class="input-block" name="rut" placeholder="ej: 18.785.387-7" required />
                    </div>
                    <div class="modal-field modal-field-estado">
                        <label>Estado</label>
                        <input class="input-block" name="estado" placeholder="ej: Pendiente" />
                    </div>
                    <div class="modal-field modal-field-penultima">
                        <label>Penúltima carpeta</label>
                        <input class="input-block" type="date" name="fechaPenultimaCarpeta" />
                    </div>
                    <button type="button" class="btn-danger remove-row-btn" title="Quitar fila" hidden>×</button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="add-row-btn" class="btn-outline">+ Agregar otro</button>
                <div class="modal-footer-actions">
                    <button type="button" class="btn-secondary" id="cancel-quick-add-btn">Cancelar</button>
                    <button class="btn-primary" type="submit">Guardar caso(s)</button>
                </div>
            </div>
        </form>
    </div>
</dialog>

<div class="card table-card">
    <table class="cases cases-list">
        <thead>
            <tr>
                <th class="th-wrap">Nombre<br />contribuyente</th>
                <th>RUT</th>
                <th>Marcar</th>
                <th class="th-wrap">Pendiente<br />carpeta</th>
                <th class="th-wrap">Fecha<br />citación</th>
                <th class="th-wrap">Sector<br />oficina</th>
                <th class="th-wrap">Estado<br />actual</th>
                <th class="th-wrap">Código<br />F8</th>
                <th class="th-wrap">
                    <a asp-page="/Index" asp-route-tab="@currentTab" asp-route-search="@Model.Search" asp-route-flagged="@(Model.Flagged == true ? "true" : null)" asp-route-sort="@(Model.Sort == "penultima-asc" ? "penultima-desc" : "penultima-asc")" class="th-sort-link" title="Ordenar filas por fecha penúltima carpeta, para elegir carpetas de un mes seguidas">
                        Fecha penúltima<br />carpeta@(Model.Sort == "penultima-asc" ? " ▲" : Model.Sort == "penultima-desc" ? " ▼" : "")
                    </a>
                </th>
                <th class="th-wrap">Sector<br />carpeta</th>
                <th class="th-wrap">Fecha subida<br />F8</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in Model.Requests)
            {
                <tr class="@(request.NeedsReview ? "row-needs-review" : "") @F8Urgentes.Dashboard.Pages.IndexModel.EstadoRowClass(request.Estado) @(request.EstadoActual == "SUBIDA A CONASET" || request.SinCarpeta ? "row-confirmed" : "")">
                    <td class="name-cell">
                        <input class="input-inline autosave" form="person-@request.Id" name="nombreCompleto" value="@request.NombreCompleto" placeholder="Nombre completo" />
                    </td>
                    <td class="rut-cell">
                        @{ var rutDisplay = F8Urgentes.Domain.RutFormatter.WithDots(request.Rut); }
                        <input class="input-inline autosave rut-input" form="person-@request.Id" name="rut" value="@rutDisplay" />
                        <form id="person-@request.Id" method="post" asp-page-handler="SetPersonData">
                            <input type="hidden" name="id" value="@request.Id" />
                        </form>
                    </td>
                    <td class="text-cell">
                        <form class="toggle-form" method="post" asp-page-handler="ToggleMarked">
                            <input type="hidden" name="id" value="@request.Id" />
                            <input type="checkbox" class="marked-checkbox" name="markedValue" value="on" checked="@request.Marked" title="Incluir en próxima impresión de sector" />
                        </form>
                    </td>
                    <td class="text-cell">
                        <form class="toggle-form" method="post" asp-page-handler="TogglePendienteCarpeta">
                            <input type="hidden" name="id" value="@request.Id" />
                            <input type="checkbox" class="pendiente-checkbox" name="pendienteCarpetaValue" value="on" checked="@request.PendienteCarpeta" title="Pendiente de carpeta" />
                        </form>
                    </td>
                    <td class="text-cell">@request.FechaPeticion</td>
                    <td class="text-cell">@(request.MatrizSector ?? "—")</td>
                    <td class="text-cell">
                        @{
                            var currentEstadoActual = string.IsNullOrEmpty(request.EstadoActual) ? "PENDIENTE" : request.EstadoActual;
                            var isLocked = currentEstadoActual == "SUBIDA A CONASET";
                        }
                        <select class="input-inline estado-actual-select @F8Urgentes.Dashboard.Pages.IndexModel.EstadoActualBadgeClass(request.EstadoActual)" form="estadoactual-@request.Id" name="estadoActual" disabled="@isLocked">
                            @if (currentEstadoActual != "CREAR CERTIFICADO")
                            {
                                <option value="@currentEstadoActual" selected>@currentEstadoActual</option>
                            }
                            <option value="CREAR CERTIFICADO" selected="@(currentEstadoActual == "CREAR CERTIFICADO")">CREAR CERTIFICADO</option>
                        </select>
                        <span class="pendiente-alert" title="Pendiente" style="@(string.IsNullOrEmpty(request.EstadoActual) || request.EstadoActual == "PENDIENTE" ? "" : "display:none")">⚠</span>
                        <form class="toggle-form" id="estadoactual-@request.Id" method="post" asp-page-handler="SetEstadoActual">
                            <input type="hidden" name="id" value="@request.Id" />
                        </form>
                    </td>
                    <td class="text-cell">
                        <input class="input-inline autosave" form="codigof8-@request.Id" name="codigoF8" value="@request.CodigoF8" placeholder="Código F8" />
                        <form id="codigof8-@request.Id" method="post" asp-page-handler="SetCodigoF8">
                            <input type="hidden" name="id" value="@request.Id" />
                        </form>
                    </td>
                    <td class="text-cell">
                        @{ var fechaPenultimaDisplay = request.FechaPenultimaCarpeta is null ? "" : F8Urgentes.Domain.SpanishDateFormatter.SlashMonthDate(request.FechaPenultimaCarpeta); }
                        <input class="input-inline autosave fecha-penultima-input" form="fechapenultima-@request.Id" name="fecha" autocomplete="fecha-penultima-@request.Id-no-autofill" data-server-value="@fechaPenultimaDisplay" value="@fechaPenultimaDisplay" placeholder="ej: 15/marzo/2024 o S/C" />
                        <form class="toggle-form" id="fechapenultima-@request.Id" method="post" asp-page-handler="SetFechaPenultimaCarpeta">
                            <input type="hidden" name="id" value="@request.Id" />
                        </form>
                    </td>
                    <td class="text-cell sector-carpeta-cell">
                        @(request.Sector switch
                        {
                            F8Urgentes.Domain.FolderSector.Archivo => "Archivo",
                            F8Urgentes.Domain.FolderSector.Oficina43 => "Oficina 43",
                            _ => "",
                        })
                    </td>
                    <td class="text-cell fecha-subida-cell">@(request.FechaDeSubida?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td class="action-cell">
                        <div class="action-group">
                            @if (request.EstadoActual != "SUBIDA A CONASET")
                            {
                                <form method="post" asp-page-handler="MarkUploaded">
                                    <input type="hidden" name="id" value="@request.Id" />
                                    <button class="btn-primary" type="submit" title="Marcar subida">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m18 15-6-6-6 6"/>
                                        </svg>
                                        <span>Subir</span>
                                    </button>
                                </form>
                            }
                            @* Sin carpeta / Caja apply to every case, with or without fecha penúltima carpeta. *@
                            @{
                                if (request.SinCarpeta)
                                {
                                    <form method="post" asp-page-handler="RevertSinCarpeta">
                                        <input type="hidden" name="id" value="@request.Id" />
                                        <button class="btn-folder btn-folder-revert" type="submit" title="Revertir Sin carpeta"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg><span>Revertir</span></button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="SetSinCarpeta">
                                        <input type="hidden" name="id" value="@request.Id" />
                                        <button class="btn-folder btn-folder-none" type="submit" title="Marcar caso como Sin carpeta"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/><line x1="9" y1="11" x2="15" y2="17"/><line x1="15" y1="11" x2="9" y2="17"/></svg><span>Sin carpeta</span></button>
                                    </form>
                                    <form method="post" asp-page-handler="SendToCaja" onsubmit="return confirm('¿Enviar a Caja? El caso pasará a la cola de Caja.');">
                                        <input type="hidden" name="id" value="@request.Id" />
                                        <button class="btn-folder btn-folder-box" type="submit" title="Enviar a Caja"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8v13H3V8"/><path d="M1 3h22v5H1z"/><line x1="10" y1="12" x2="14" y2="12"/></svg><span>Caja</span></button>
                                    </form>
                                }
                            }
                            @if (request.EstadoActual == "CREAR CERTIFICADO")
                            {
                                <form method="post" asp-page-handler="EnviarCorreoCertificadoV2">
                                    <input type="hidden" name="id" value="@request.Id" />
                                    <button class="btn-sync" type="submit" title="Enviar correo a Matías solicitando el certificado">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                                        </svg>
                                    </button>
                                </form>
                            }
                            <form method="post" asp-page-handler="DeleteCase" onsubmit="return confirm('¿Eliminar esta solicitud?');">
                                <input type="hidden" name="id" value="@request.Id" />
                                <button class="btn-danger" type="submit" title="Eliminar">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        <line x1="10" y1="11" x2="10" y2="17"></line>
                                        <line x1="14" y1="11" x2="14" y2="17"></line>
                                    </svg>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    (function () {
        document.querySelectorAll('input.fecha-penultima-input').forEach(function (input) {
            input.name = 'fecha';
        });
    })();

    (function () {
        var scrollKey = 'f8-index-scroll';
        var table = document.querySelector('.card.table-card');
        var saved = sessionStorage.getItem(scrollKey);
        if (saved !== null) {
            sessionStorage.removeItem(scrollKey);
            try {
                var pos = JSON.parse(saved);
                setTimeout(function () {
                    window.scrollTo(0, pos.y || 0);
                    if (table) {
                        table.scrollLeft = pos.x || 0;
                        table.scrollTop = pos.ty || 0;
                    }
                }, 60);
            } catch (err) { /* malformed value, skip restore */ }
        }
        document.addEventListener('submit', function () {
            sessionStorage.setItem(scrollKey, JSON.stringify({
                y: window.scrollY,
                x: table ? table.scrollLeft : 0,
                ty: table ? table.scrollTop : 0
            }));
        });
    })();

    // Modal behavior for Agregar Caso
    (function () {
        var modal = document.getElementById('quick-add-modal');
        var openBtn = document.getElementById('open-quick-add-btn');
        var closeBtn = document.getElementById('close-quick-add-btn');
        var cancelBtn = document.getElementById('cancel-quick-add-btn');

        function openModal() {
            if (!modal) return;
            if (typeof modal.showModal === 'function') {
                modal.showModal();
            } else {
                modal.setAttribute('open', '');
            }
            var firstInput = modal.querySelector('input[name="nombreCompleto"]');
            if (firstInput) setTimeout(function () { firstInput.focus(); }, 50);
        }

        function closeModal() {
            if (!modal) return;
            if (typeof modal.close === 'function') {
                modal.close();
            } else {
                modal.removeAttribute('open');
            }
        }

        if (openBtn) openBtn.addEventListener('click', openModal);
        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
        if (modal) {
            modal.addEventListener('click', function (e) {
                if (e.target === modal) closeModal();
            });
        }
    })();

    document.getElementById('quick-add-rows').addEventListener('click', function (event) {
        if (event.target.classList.contains('remove-row-btn')) {
            event.target.closest('.quick-add-row').remove();
        }
    });

    document.getElementById('add-row-btn').addEventListener('click', function () {
        var rows = document.getElementById('quick-add-rows');
        var row = document.createElement('div');
        row.className = 'quick-add-row modern-modal-row';
        row.innerHTML = '<div class="modal-field"><label>Nombre completo</label><input class="input-block" name="nombreCompleto" placeholder="ej: Gustavo Peña Castro" required /></div>' +
            '<div class="modal-field modal-field-rut"><label>RUT</label><input class="input-block" name="rut" placeholder="ej: 18.785.387-7" required /></div>' +
            '<div class="modal-field modal-field-estado"><label>Estado</label><input class="input-block" name="estado" placeholder="ej: Pendiente" /></div>' +
            '<div class="modal-field modal-field-penultima"><label>Penúltima carpeta</label><input class="input-block" type="date" name="fechaPenultimaCarpeta" /></div>' +
            '<button type="button" class="btn-danger remove-row-btn" title="Quitar fila">×</button>';
        rows.appendChild(row);
    });

    function submitToggle(form, onSuccess) {
        var formData = new FormData(form);
        fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function (response) {
            return response.json().catch(function () { return null; }).then(function (data) {
                return { ok: response.ok, status: response.status, data: data };
            });
        })
        .then(function (result) {
            if (!result.ok) {
                console.error('Toggle submit failed:', result.status);
            }
            if (onSuccess) {
                onSuccess(result.data, result.ok);
            }
        })
        .catch(function (err) {
            console.error('Toggle submit error:', err);
        });
    }

    // Marcar (amarillo) y Pendiente carpeta (morado) son mutuamente excluyentes. El color de fila
    // es puro CSS (:has(.marked-checkbox:checked)), reacciona solo con el checked nativo — lo único
    // que hace falta acá es desmarcar la otra casilla al tocar una, para que el CSS reaccione al
    // toque en vez de esperar el reload; el servidor ya lo garantiza igual (SetMarked/
    // SetPendienteCarpeta se limpian entre sí), esto solo evita que la casilla vieja se vea marcada
    // hasta que vuelva la respuesta.
    try {
        function wireExclusiveCheckbox(checkbox, siblingSelector) {
            checkbox.addEventListener('change', function () {
                var row = checkbox.closest('tr');
                var sibling = row ? row.querySelector(siblingSelector) : null;
                if (checkbox.checked && sibling) {
                    sibling.checked = false;
                }

                if (checkbox.form) {
                    submitToggle(checkbox.form, function (data, ok) {
                        if (!ok || !data || !row) return;
                        var markedBox = row.querySelector('input.marked-checkbox');
                        var pendienteBox = row.querySelector('input.pendiente-checkbox');
                        if (markedBox) markedBox.checked = !!data.marked;
                        if (pendienteBox) pendienteBox.checked = !!data.pendienteCarpeta;
                    });
                }
            });
        }

        document.querySelectorAll('input.marked-checkbox').forEach(function (checkbox) {
            wireExclusiveCheckbox(checkbox, 'input.pendiente-checkbox');
        });

        document.querySelectorAll('input.pendiente-checkbox').forEach(function (checkbox) {
            wireExclusiveCheckbox(checkbox, 'input.marked-checkbox');
        });
    } catch (err) {
        console.error('Marcar/Pendiente Carpeta wiring failed', err);
    }

    try {
        var estadoActualBadgeClasses = {
            'PENDIENTE': 'badge-pending',
            'SUBIDA A CONASET': 'badge-confirmed',
            'CREAR CERTIFICADO': 'badge-review'
        };

        document.querySelectorAll('select.estado-actual-select').forEach(function (select) {
            select.addEventListener('change', function () {
                Object.values(estadoActualBadgeClasses).forEach(function (cls) { select.classList.remove(cls); });
                select.classList.add(estadoActualBadgeClasses[select.value] || 'badge-review');

                var row = select.closest('tr');
                if (row) {
                    row.classList.toggle('row-confirmed', select.value === 'SUBIDA A CONASET');
                }

                var fechaCell = row ? row.querySelector('.fecha-subida-cell') : null;
                if (fechaCell) {
                    if (select.value === 'SUBIDA A CONASET') {
                        fechaCell.textContent = new Intl.DateTimeFormat('es-CL', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(new Date());
                    } else {
                        fechaCell.textContent = '—';
                    }
                }

                var alertIcon = select.parentElement ? select.parentElement.querySelector('.pendiente-alert') : null;
                if (alertIcon) {
                    alertIcon.style.display = select.value === 'PENDIENTE' ? '' : 'none';
                }

                if (select.form) {
                    submitToggle(select.form, function (payload) {
                        if (payload && payload.fechaDeSubida && fechaCell) {
                            fechaCell.textContent = payload.fechaDeSubida;
                        }
                    });
                }
            });
        });
    } catch (err) {
        console.error('Estado actual dropdown wiring failed', err);
    }

    try {
        document.querySelectorAll('input.rut-input').forEach(function (input) {
            input.addEventListener('copy', function (event) {
                var selected = input.value.substring(input.selectionStart, input.selectionEnd);
                if (!selected) {
                    return;
                }
                event.clipboardData.setData('text/plain', selected.replace(/\./g, ''));
                event.preventDefault();
            });
        });
    } catch (err) {
        console.error('RUT copy wiring failed', err);
    }

    // Nombre, RUT, Código F8 y Fecha penúltima carpeta save via fetch on blur, plus 'submit' as a
    // backstop in case a browser does implicit-submit the form. Enter is wired explicitly (not left
    // to rely on implicit submission): these inputs are associated to their <form> via the `form`
    // attribute rather than being DOM descendants of it, and confirmed live that some engines never
    // fire implicit submission for that case — Enter would silently do nothing. Forcing a blur()
    // reuses the already-working save path instead of duplicating it.
    try {
        function autosaveOnSuccess(input) {
            return function (data, ok) {
                if (!input.classList.contains('fecha-penultima-input')) return;
                if (!ok) {
                    alert(data && data.message ? data.message : 'No se pudo guardar la fecha.');
                    return;
                }
                if (data && typeof data.fecha === 'string') {
                    input.value = data.fecha;
                }
                var row = input.closest('tr');
                var sectorCell = row ? row.querySelector('.sector-carpeta-cell') : null;
                if (sectorCell) {
                    sectorCell.textContent = data && data.sector === 'Archivo' ? 'Archivo'
                        : data && data.sector === 'Oficina43' ? 'Oficina 43'
                        : '';
                }
            };
        }

        var autosaveWiredForms = new WeakSet();
        document.querySelectorAll('input.autosave').forEach(function (input) {
            var form = input.form;
            if (!form) return;

            input.addEventListener('blur', function () {
                submitToggle(form, autosaveOnSuccess(input));
            });

            input.addEventListener('keydown', function (event) {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    input.blur();
                }
            });

            if (!autosaveWiredForms.has(form)) {
                autosaveWiredForms.add(form);
                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    submitToggle(form, autosaveOnSuccess(input));
                });
            }
        });
    } catch (err) {
        console.error('Autosave inputs wiring failed', err);
    }

    try {
        function updateStickyOffsets() {
            var table = document.querySelector('table.cases-list');
            if (!table) return;
            var ths = table.querySelectorAll('thead th');
            if (ths.length < 2) return;

            var wNombre = Math.round(ths[0].getBoundingClientRect().width);

            table.style.setProperty('--sticky-rut', wNombre + 'px');

            var styleEl = document.getElementById('sticky-offsets-style');
            if (!styleEl) {
                styleEl = document.createElement('style');
                styleEl.id = 'sticky-offsets-style';
                document.head.appendChild(styleEl);
            }
            styleEl.textContent =
                'table.cases-list th:nth-child(1), table.cases-list td:nth-child(1) { left: 0px !important; position: sticky !important; z-index: 6 !important; }\n' +
                'table.cases-list th:nth-child(2), table.cases-list td:nth-child(2) { left: ' + wNombre + 'px !important; position: sticky !important; z-index: 6 !important; border-right: 2px solid #94a3b8 !important; box-shadow: 4px 0 8px -2px rgba(15,23,42,0.18) !important; }\n' +
                'table.cases-list thead th:nth-child(1), table.cases-list thead th:nth-child(2) { z-index: 25 !important; background-color: #f8fafc !important; }';
        }
        window.addEventListener('DOMContentLoaded', updateStickyOffsets);
        window.addEventListener('load', updateStickyOffsets);
        window.addEventListener('resize', updateStickyOffsets);
        if (document.fonts) document.fonts.ready.then(updateStickyOffsets);
        setTimeout(updateStickyOffsets, 0);
        setTimeout(updateStickyOffsets, 80);
        setTimeout(updateStickyOffsets, 400);
    } catch (err) {
        console.error('Sticky offset calculation failed', err);
    }
</script>

<script>
    // RUT mask for the header search box: when the text looks like a RUT (digits, dots, dash, K),
    // reformat as 12.345.678-9 while typing. Names are left untouched.
    (function () {
        var input = document.getElementById('headerSearchInput');
        if (!input) return;
        function formatRut(value) {
            var clean = value.replace(/[.\-\s]/g, '').toUpperCase();
            if (clean.length < 2) return clean;
            var body = clean.slice(0, -1), dv = clean.slice(-1);
            return body.replace(/\B(?=(\d{3})+(?!\d))/g, '.') + '-' + dv;
        }
        function looksLikeRut(value) {
            return /^[\d.\-\s]*[\dkK]?$/.test(value) && /\d/.test(value);
        }
        input.addEventListener('input', function () {
            var v = input.value;
            if (!looksLikeRut(v)) return;
            var f = formatRut(v);
            if (f !== v) {
                input.value = f;
                input.setSelectionRange(f.length, f.length);
            }
            updateClearBtn();
        });
        if (looksLikeRut(input.value)) input.value = formatRut(input.value);
        updateClearBtn();

        function updateClearBtn() {
            var clear = input.parentElement.querySelector('.header-search-clear');
            if (!clear) return;
            clear.style.display = input.value ? 'inline-flex' : 'none';
        }
    })();
</script>
