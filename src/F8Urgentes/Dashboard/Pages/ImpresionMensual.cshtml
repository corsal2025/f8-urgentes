@page
@model F8Urgentes.Dashboard.Pages.ImpresionMensualModel
@{
    ViewData["Title"] = "Impresión mensual";
}

<div class="nav-group no-print">
    <form method="get" style="display:flex; gap:8px; align-items:center;">
        <label for="month">Mes de trabajo</label>
        <input type="month" id="month" name="month" value="@Model.Month" />
        <button type="submit" class="btn-outline">Ver mes</button>
    </form>
</div>

@if (Model.Cases.Count > 0)
{
    <div class="nav-group no-print" style="align-items:center;">
        <button type="button" class="btn-primary" onclick="window.print()">Imprimir / Guardar como PDF</button>
        <form id="mark-printed-form" method="post" asp-page-handler="MarkPrinted" style="display:inline-block;" onsubmit="return confirm('¿Vaciar el listado del mes @Model.Month? Se marcara como impreso.');">
            <input type="hidden" name="month" value="@Model.Month" />
            <button type="submit" class="btn-danger">Vaciar listado</button>
        </form>
        <label style="display:flex; align-items:center; gap:6px;">
            Tamaño de hoja
            <select id="page-size-select" onchange="setPageSize(this.value)">
                <option value="A4">A4</option>
                <option value="letter">Letter</option>
            </select>
        </label>
        <span style="font-size:0.8rem; color:#666;">Este listado muestra las carpetas completadas (SUBIDA A CONASET) de @Model.Month.</span>
    </div>
}
<style id="page-size-style">@@page { size: A4; margin: 12mm; }</style>
<script>
    function setPageSize(size) {
        document.getElementById('page-size-style').textContent = '\x40page { size: ' + size + '; margin: 12mm; }';
    }

    // Vacía el listado (apaga el aviso del dashboard) automáticamente después de imprimir, para no
    // depender de que alguien se acuerde de tocar "Vaciar listado" a mano. form.submit() no dispara
    // el evento 'submit' del form (así funciona el DOM), así que salta el confirm() — correcto acá,
    // porque esto ya es la confirmación implícita: imprimir dijo "ya terminé con este mes".
    // afterprint dispara también si se cancela el diálogo de impresión en algunos navegadores; el
    // costo de ese falso positivo es bajo (hay que volver a generar el listado del mes) comparado
    // con el aviso quedando pegado semanas.
    window.addEventListener('afterprint', function () {
        var form = document.getElementById('mark-printed-form');
        if (form) form.submit();
    });
</script>

<div class="print-report print-report-visible">
    <div class="print-header">
        <div class="print-header-brand">
            <img src="~/img/logo-municipalidad.png" alt="Municipalidad de Valparaíso" />
            <div>
                <div class="org-name">Municipalidad de Valparaíso — Dirección de Tránsito</div>
                <div class="report-name">F8 — Listado de carpetas — Listado penúltima carpeta</div>
            </div>
        </div>
        <div class="print-header-folio">
            <div>Folio: <strong>@Model.Folio</strong></div>
            <div>Generado: <strong>@Model.GeneratedAt.ToString("dd-MM-yyyy HH:mm")</strong></div>
        </div>
    </div>

    <div class="print-subtitle-bar">
        <span>Casos con carpeta subida a CONASET durante @Model.Month</span>
        <strong>@Model.Cases.Count registro(s)</strong>
    </div>

    <div class="print-table-scroll">
    <table class="cases print-table">
        <thead>
            <tr>
                <th>N°</th>
                <th>Nombre completo</th>
                <th>RUT</th>
                <th>Fecha penúltima carpeta</th>
            </tr>
        </thead>
        <tbody>
            @{ var n = 0; }
            @foreach (var request in Model.Cases)
            {
                n++;
                <tr>
                    <td class="text-cell">@n</td>
                    <td class="name-cell">@request.NombreCompleto</td>
                    <td class="text-cell">@request.Rut</td>
                    <td class="text-cell">@F8Urgentes.Domain.SpanishDateFormatter.LongDate(request.FechaPenultimaCarpeta)</td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <p class="print-total">Total: @Model.Cases.Count carpeta(s)</p>

    <div class="print-signatures print-signatures-single">
        <div class="print-signature">Quien solicita</div>
    </div>

    @if (Model.Cases.Count == 0)
    {
        <p style="text-align:center; color:#666; padding:20px;">No hay carpetas completadas para @Model.Month.</p>
    }
</div>
