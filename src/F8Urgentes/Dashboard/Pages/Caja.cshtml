@page "{boxId:long?}"
@model F8Urgentes.Dashboard.Pages.CajaModel
@{
    ViewData["Title"] = "Caja";
}

<partial name="_ToolNav" />
<style>
    @@page { size: A4 portrait; margin: 10mm 10mm 12mm; }

    .acta { background:#fff; color:#1f2937; max-width: 820px; margin: 0 auto; padding: 28px 32px 22px; border:1px solid var(--color-border); border-radius:10px; box-shadow:0 4px 18px rgba(15,23,42,.08); font-size: 10pt; }
    .acta-letterhead { display:flex; align-items:center; gap:18px; padding-bottom:12px; border-bottom: 3px solid #1c3f60; position:relative; }
    .acta-letterhead::after { content:""; position:absolute; left:0; right:0; bottom:-7px; border-bottom:1px solid #c9a227; }
    .acta-logo { height: 78px; width:auto; image-rendering:-webkit-optimize-contrast; }
    .acta-inst { flex:1; line-height:1.25; }
    .acta-inst .l1 { font-size: 13pt; font-weight:800; letter-spacing:.06em; color:#1c3f60; text-transform:uppercase; }
    .acta-inst .l2 { font-size: 9.5pt; color:#475569; font-weight:600; margin-top:2px; }
    .acta-inst .l3 { font-size: 8.5pt; color:#64748b; margin-top:1px; }
    .acta-code { text-align:center; border:2px solid #1c3f60; border-radius:8px; padding:6px 14px; min-width:110px; }
    .acta-code .k { font-size:7.5pt; letter-spacing:.12em; color:#64748b; text-transform:uppercase; }
    .acta-code .v { font-size:17pt; font-weight:800; color:#1c3f60; line-height:1.1; }
    .acta-title { text-align:center; margin:22px 0 14px; }
    .acta-title h2 { margin:0; font-size:15pt; letter-spacing:.08em; text-transform:uppercase; color:#0f172a; }
    .acta-title p { margin:4px 0 0; font-size:9pt; color:#64748b; }
    .acta-meta { display:grid; grid-template-columns: repeat(3, 1fr); border:1px solid #cbd5e1; border-radius:6px; overflow:hidden; margin-bottom:14px; }
    .acta-meta > div { padding:7px 10px; border-right:1px solid #cbd5e1; background:#f8fafc; }
    .acta-meta > div:last-child { border-right:none; }
    .acta-meta .k { display:block; font-size:7.5pt; text-transform:uppercase; letter-spacing:.08em; color:#64748b; }
    .acta-meta .v { font-size:10.5pt; font-weight:700; color:#0f172a; }
    table.acta-table { width:100%; border-collapse:collapse; font-size:9pt; }
    table.acta-table thead th { background:#1c3f60; color:#fff; font-size:7.8pt; font-weight:700; letter-spacing:.05em; text-transform:uppercase; padding:6px; border:1px solid #1c3f60; text-align:center; }
    table.acta-table tbody td { padding:4px 6px; border-bottom:1px solid #e2e8f0; border-left:1px solid #eef2f6; border-right:1px solid #eef2f6; text-align:center; }
    table.acta-table tbody tr:nth-child(even) td { background:#f4f7fb; }
    table.acta-table td.n { font-weight:700; color:#1c3f60; width:42px; }
    table.acta-table td.nom { text-align:left; font-weight:600; }
    table.acta-table td.mono { font-variant-numeric: tabular-nums; white-space:nowrap; }
    table.acta-table tfoot td { padding:6px; font-weight:700; background:#eef2f6; border-top:2px solid #1c3f60; text-align:right; }
    .acta-signs { display:grid; grid-template-columns:1fr 1fr; gap:48px; margin-top:54px; break-inside:avoid; }
    .acta-signs div { border-top:1px solid #334155; padding-top:5px; text-align:center; font-size:8.5pt; color:#334155; }
    .acta-signs small { display:block; color:#94a3b8; margin-top:2px; }
    .acta-foot { margin-top:22px; padding-top:6px; border-top:1px solid #e2e8f0; display:flex; justify-content:space-between; font-size:7.5pt; color:#94a3b8; }

    @@media print {
        html, body { width:auto !important; min-width:0 !important; }
        .stats-scroll { width:100% !important; max-width:none !important; }
        .acta { max-width:none !important; border:none !important; box-shadow:none !important; border-radius:0 !important; padding:0 !important; margin:0 !important; background:#fff !important; }
        .acta, .acta * { -webkit-print-color-adjust:exact; print-color-adjust:exact; }
        table.acta-table thead { display:table-header-group; }
        table.acta-table tr { break-inside:avoid; page-break-inside:avoid; }
        table.acta-table thead th { background:#1c3f60 !important; color:#fff !important; }
    }
</style>


<div class="stats-scroll">
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="card alert-banner alert-success no-print">@Model.Message</div>
}

@if (Model.SelectedBox is { } box)
{
    <div class="no-print caja-toolbar" style="margin-bottom: 14px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
        <a asp-page="/Caja" class="btn-outline">&larr; Volver a Caja</a>
        <button type="button" class="btn-primary" onclick="window.print()">🖨️ Imprimir / Guardar como PDF</button>
        <form method="post" asp-page-handler="ReopenBox" style="display:inline; margin-left:auto;"
              onsubmit="return confirm('¿Reabrir la Caja @box.Code? Sus casos volverán a la cola abierta para que puedas quitar los que sobren, agregar otros o corregirlos.');">
            <input type="hidden" name="boxId" value="@box.Id" />
            <button type="submit" class="btn-outline btn-warning">
                🔓 Reabrir Caja (Deshacer Cierre)
            </button>
        </form>
    </div>

    <div class="acta">
        <div class="acta-letterhead">
            <img src="~/img/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="acta-logo" />
            <div class="acta-inst">
                <div class="l1">Ilustre Municipalidad de Valparaíso</div>
                <div class="l2">Departamento de Licencias de Conducir</div>
                <div class="l3">Sistema F8 Urgentes · Control de carpetas</div>
            </div>
            <div class="acta-code">
                <div class="k">Caja</div>
                <div class="v">@box.Code</div>
            </div>
        </div>

        <div class="acta-title">
            <h2>Listado de Carpetas en Caja</h2>
            <p>Carpetas en el orden en que fueron ingresadas a la caja</p>
        </div>

        <div class="acta-meta">
            <div><span class="k">Código de caja</span><span class="v">@box.Code</span></div>
            <div><span class="k">Fecha de cierre</span><span class="v">@box.ClosedAt.LocalDateTime.ToString("dd-MM-yyyy HH:mm")</span></div>
            <div><span class="k">Total de carpetas</span><span class="v">@Model.SelectedBoxCases.Count</span></div>
        </div>

        @if (Model.SelectedBoxCases.Count == 0)
        {
            <p class="caja-empty">Esta caja se cerró sin casos.</p>
        }
        else
        {
            <table class="acta-table">
                <thead>
                    <tr>
                        <th>N°</th>
                        <th style="text-align:left;">Nombre completo</th>
                        <th>RUT</th>
                        <th>Fecha penúltima carpeta</th>
                    </tr>
                </thead>
                <tbody>
                @{ var correlativo = 0; }
                @foreach (var item in Model.SelectedBoxCases)
                {
                    correlativo++;
                    <tr>
                        <td class="n">@correlativo</td>
                        <td class="nom">@item.NombreCompleto</td>
                        <td class="mono">@F8Urgentes.Domain.RutFormatter.WithDots(item.Rut)</td>
                        <td>@(item.FechaPenultimaCarpeta is { } f ? F8Urgentes.Domain.SpanishDateFormatter.SlashMonthDate(f) : "S/C")</td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr><td colspan="4">Total de carpetas: @Model.SelectedBoxCases.Count</td></tr>
                </tfoot>
            </table>
        }

        <div class="acta-signs">
            <div>Entregado por<small>Nombre, firma y fecha</small></div>
            <div>Recibido por<small>Nombre, firma y fecha</small></div>
        </div>

        <div class="acta-foot">
            <span>Municipalidad de Valparaíso · Licencias de Conducir</span>
            <span>Emitido: @DateTime.Now.ToString("dd-MM-yyyy HH:mm")</span>
        </div>
    </div>
}
else
{
    <div class="caja-section">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; flex-wrap:wrap; gap:10px;">
            <h2 style="margin:0;">Cola de casos para la próxima caja (<span id="queueTotalCount">@Model.Queue.Count</span> en cola)</h2>
            @if (Model.Queue.Count > 0)
            {
                <form id="undoBatchForm" method="post" asp-page-handler="UndoBatch" style="display:inline;">
                    <button type="button" id="btnUndoBatch" class="btn-danger" onclick="submitUndoBatch()" disabled style="padding:4px 10px; font-size:0.78rem;">
                        Quitar seleccionados (<span id="undoCount">0</span>)
                    </button>
                </form>
            }
        </div>

        <div class="card table-card" style="height:auto; max-height:480px; overflow-y:auto;">
            @if (Model.Queue.Count == 0)
            {
                <p class="caja-empty">No hay casos en la cola. Ve a <strong>Solicitudes</strong> y presiona "Caja" en los casos con fecha penúltima carpeta.</p>
            }
            else
            {
                <table class="cases queue-table">
                    <thead>
                        <tr>
                            <th style="width:36px;"><input type="checkbox" id="selectAllQueue" onclick="toggleSelectAll(this)" title="Seleccionar todos" /></th>
                            <th>N° orden</th>
                            <th style="text-align:left;">Nombre</th>
                            <th>RUT</th>
                            <th>Código F8</th>
                            <th>Fecha penúltima carpeta</th>
                            <th class="no-print">Sector</th>
                            <th style="width:85px;">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                    @{ var correlativoQueue = 0; }
                    @foreach (var item in Model.Queue)
                    {
                        correlativoQueue++;
                        <tr>
                            <td style="text-align:center;"><input type="checkbox" class="queue-check" value="@item.Id" onchange="updateQueueSelection()" /></td>
                            <td>@correlativoQueue</td>
                            <td style="text-align:left; font-weight:600;">@item.NombreCompleto</td>
                            <td style="text-align:center;">@F8Urgentes.Domain.RutFormatter.WithDots(item.Rut)</td>
                            <td style="text-align:center;">@item.CodigoF8</td>
                            <td style="text-align:center;">@(item.FechaPenultimaCarpeta is { } f ? F8Urgentes.Domain.SpanishDateFormatter.SlashMonthDate(f) : "S/C")</td>
                            <td class="no-print" style="text-align:center;">@(item.Sector switch { F8Urgentes.Domain.FolderSector.Archivo => "Archivo", F8Urgentes.Domain.FolderSector.Oficina43 => "Oficina 43", _ => "" })</td>
                            <td style="text-align:center;">
                                <form method="post" asp-page-handler="UndoSingle" style="display:inline;"
                                      onsubmit="return confirm('¿Quitar a @item.NombreCompleto de la cola de caja y devolverlo a Casos?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-danger" title="Quitar de la caja y devolver a Casos" style="padding:3px 8px; font-size:0.75rem;">Quitar</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
        <form method="post" asp-page-handler="CerrarCaja" style="margin-top:14px; display:flex; gap:12px; align-items:center; flex-wrap:wrap;"
              onsubmit="var num = document.getElementById('boxNumberInput')?.value || '@Model.NextBoxNumber'; return confirm('¿Confirmar cierre de caja A' + num + '-PUC con los @Model.Queue.Count caso(s) de la cola?');">
            <label for="boxNumberInput" style="font-weight:700; font-size:0.85rem; color:var(--color-primary);">Rótulo / N° de Caja:</label>
            <div style="display:inline-flex; align-items:center; border:1px solid var(--color-border); border-radius:6px; overflow:hidden; background:var(--color-bg); height:38px;">
                <span style="padding:0 12px; font-weight:700; color:var(--color-primary); background:var(--color-surface); border-right:1px solid var(--color-border); line-height:38px;">A</span>
                <input type="number" id="boxNumberInput" name="boxNumber" value="@Model.NextBoxNumber" min="1" step="1" required
                       oninput="updateCerrarBtnText(this.value)"
                       style="width:70px; text-align:center; font-weight:700; border:none; outline:none; background:transparent; color:var(--color-text); padding:0;" />
                <span style="padding:0 12px; font-weight:700; color:var(--color-text-muted); background:var(--color-surface); border-left:1px solid var(--color-border); line-height:38px;">-PUC</span>
            </div>
            <button type="submit" id="btnCerrarCaja" class="btn-primary" @(Model.Queue.Count == 0 ? "disabled" : "")>
                Cerrar Caja <span id="cerrarBoxCodeLabel">A@(Model.NextBoxNumber)-PUC</span> (@Model.Queue.Count casos)
            </button>
        </form>
    </div>

    <script>
        function updateCerrarBtnText(val) {
            var num = (val || '').trim() || '@Model.NextBoxNumber';
            var label = document.getElementById('cerrarBoxCodeLabel');
            if (label) label.textContent = 'A' + num + '-PUC';
        }
        function toggleSelectAll(master) {
            document.querySelectorAll('.queue-check').forEach(function (c) { c.checked = master.checked; });
            updateQueueSelection();
        }
        function updateQueueSelection() {
            var checked = document.querySelectorAll('.queue-check:checked');
            var countSpan = document.getElementById('undoCount');
            var btn = document.getElementById('btnUndoBatch');
            if (countSpan) countSpan.textContent = checked.length;
            if (btn) btn.disabled = checked.length === 0;
            var allChecks = document.querySelectorAll('.queue-check');
            var master = document.getElementById('selectAllQueue');
            if (master && allChecks.length > 0) master.checked = checked.length === allChecks.length;
        }
        function submitUndoBatch() {
            var checked = document.querySelectorAll('.queue-check:checked');
            if (checked.length === 0) return;
            if (!confirm('¿Quitar los ' + checked.length + ' caso(s) seleccionados de la cola de caja y devolverlos a Casos?')) return;
            var form = document.getElementById('undoBatchForm');
            form.querySelectorAll('input[name="selectedIds"]').forEach(function (el) { el.remove(); });
            checked.forEach(function (c) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'selectedIds';
                input.value = c.value;
                form.appendChild(input);
            });
            form.submit();
        }
    </script>

    <div class="caja-section">
        <h2>Cajas cerradas (@Model.ClosedBoxes.Count)</h2>
        <div class="card table-card" style="height:auto; overflow:visible;">
            @if (Model.ClosedBoxes.Count == 0)
            {
                <p class="caja-empty">Todavía no se ha cerrado ninguna caja.</p>
            }
            else
            {
                <table class="cases boxes-history">
                    <thead>
                        <tr>
                            <th>Caja</th>
                            <th>Cerrada</th>
                            <th>Casos</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var closedBox in Model.ClosedBoxes)
                    {
                        var count = Model.BoxCounts.GetValueOrDefault(closedBox.Id, 0);
                        <tr>
                            <td><strong>@closedBox.Code</strong></td>
                            <td>@closedBox.ClosedAt.LocalDateTime.ToString("dd-MM-yyyy HH:mm")</td>
                            <td style="text-align:center;"><span class="badge badge-uploaded">@count caso(s)</span></td>
                            <td>
                                <a asp-page="/Caja" asp-route-boxId="@closedBox.Id" class="box-link">Ver listado / imprimir</a>
                                <form method="post" asp-page-handler="ReopenBox" style="display:inline; margin-left:12px;"
                                      onsubmit="return confirm('¿Reabrir la Caja @closedBox.Code? Sus @count casos volverán a la cola abierta para que puedas corregirlos.');">
                                    <input type="hidden" name="boxId" value="@closedBox.Id" />
                                    <button type="submit" class="btn-outline" style="color:#b45309; padding:2px 8px; font-size:0.75rem;">Reabrir</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
}
</div>
