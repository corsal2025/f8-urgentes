@page "/Registro"
@model F8Urgentes.Dashboard.Pages.RegistroModel
@{
    ViewData["Title"] = "Registro - F8 Urgentes";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/f8-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tema-lico.css" asp-append-version="true" />
</head>
<body class="login-shell">
    <div class="login-card">
        <div class="brand">
            <span class="login-lico" data-lico="saluda" aria-hidden="true"></span>
            <img src="~/img/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="brand-logo" />
            <h2>Registro F8</h2>
        </div>

        <p class="subtitle">Crea tu cuenta en el sistema de urgentes</p>

        <form method="post">
            @if (!ModelState.IsValid)
            {
                <div class="error">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <div class="field">
                <label for="Username">Usuario</label>
                <input type="text" asp-for="Username" placeholder="Elige un usuario" required />
            </div>

            <div class="field">
                <label for="password-input">Contraseña</label>
                <div class="password-field">
                    <input type="password" asp-for="Password" id="password-input" placeholder="Ingresa tu contraseña" required />
                    <button type="button" id="toggle-password" class="password-toggle" aria-label="Mostrar contraseña">👁️</button>
                </div>
            </div>

            <div class="field">
                <label for="PreguntaSecreta">Pregunta secreta (para recuperar tu clave)</label>
                <input type="text" asp-for="PreguntaSecreta" placeholder="Ej: Nombre de mi primera mascota" required />
            </div>

            <div class="field">
                <label for="RespuestaSecreta">Respuesta secreta</label>
                <input type="text" asp-for="RespuestaSecreta" placeholder="Respuesta a la pregunta" required />
            </div>

            <button type="submit" class="btn-submit">Registrar cuenta</button>

            <div class="login-links login-links-centro">
                <a href="/Login">Volver al acceso</a>
            </div>
        </form>
    </div>

    <script>
        document.getElementById('toggle-password').addEventListener('click', function() {
            var pwd = document.getElementById('password-input');
            if (pwd.type === 'password') {
                pwd.type = 'text';
                this.textContent = '🙈';
            } else {
                pwd.type = 'password';
                this.textContent = '👁️';
            }
        });
    </script>
    <script src="~/js/lico.js" asp-append-version="true"></script>
</body>
</html>
