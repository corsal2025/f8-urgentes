@page "/Registro"
@model F8Urgentes.Dashboard.Pages.RegistroModel
@{
    ViewData["Title"] = "Registro - F8 Urgentes";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/f8-dashboard.css" asp-append-version="true" />
</head>
<body class="login-shell">
    <div class="login-card">
        <div class="brand" style="justify-content: center; margin-bottom: 1.5rem; text-align: center;">
            <img src="~/img/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="brand-logo" style="margin: 0 auto; display: block; filter: brightness(0) invert(1);" />
            <h2 style="margin-top: 10px; color: #ffffff;">Registro F8</h2>
        </div>
        
        <p class="subtitle">Crea tu cuenta en el sistema de urgentes</p>
        
        <form method="post">
            @if (!ModelState.IsValid)
            {
                <div class="error" style="color: #ffbaba; background: rgba(220, 53, 69, 0.2); border-left: 4px solid #dc3545; padding: 10px; margin-bottom: 15px; font-size: 0.9rem; border-radius: 4px;">
                    <div asp-validation-summary="All"></div>
                </div>
            }
            
            <div style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px; font-weight: 500; font-size: 0.9rem; color: #ffffff;">Usuario</label>
                <input type="text" asp-for="Username" placeholder="Elige un usuario" required style="width: 100%; padding: 10px; border: 1px solid rgba(255,255,255,0.3); border-radius: 6px; background: rgba(255,255,255,0.1); color: #fff;" />
            </div>
            
            <div style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px; font-weight: 500; font-size: 0.9rem; color: #ffffff;">Contraseña</label>
                <div class="password-field" style="position: relative;">
                    <input type="password" asp-for="Password" id="password-input" placeholder="Ingresa tu contraseña" required style="width: 100%; padding: 10px; padding-right: 40px; border: 1px solid rgba(255,255,255,0.3); border-radius: 6px; background: rgba(255,255,255,0.1); color: #fff;" />
                    <button type="button" id="toggle-password" style="position: absolute; right: 5px; top: 50%; transform: translateY(-50%); background: none; border: none; font-size: 1.1rem; cursor: pointer; color: rgba(255,255,255,0.7);">👁️</button>
                </div>
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px; font-weight: 500; font-size: 0.9rem; color: #ffffff;">Pregunta Secreta (para recuperar tu clave)</label>
                <input type="text" asp-for="PreguntaSecreta" placeholder="Ej: Nombre de mi primera mascota" required style="width: 100%; padding: 10px; border: 1px solid rgba(255,255,255,0.3); border-radius: 6px; background: rgba(255,255,255,0.1); color: #fff;" />
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 5px; font-weight: 500; font-size: 0.9rem; color: #ffffff;">Respuesta Secreta</label>
                <input type="text" asp-for="RespuestaSecreta" placeholder="Respuesta a la pregunta" required style="width: 100%; padding: 10px; border: 1px solid rgba(255,255,255,0.3); border-radius: 6px; background: rgba(255,255,255,0.1); color: #fff;" />
            </div>
            
            <button type="submit" style="width: 100%; padding: 12px; background: #ffffff; color: var(--color-primary-dark); border: none; border-radius: 6px; font-weight: 700; cursor: pointer; transition: background 0.2s;">
                Registrar Cuenta
            </button>

            <div style="text-align: center; font-size: 0.85rem; margin-top: 15px;">
                <a href="/Login" style="color: rgba(255,255,255,0.9); text-decoration: underline;">Volver al acceso</a>
            </div>
        </form>
    </div>

    <script>
        document.getElementById('toggle-password').addEventListener('click', function() {
            var pwd = document.getElementById('password-input');
            if (pwd.type === 'password') {
                pwd.type = 'text';
                this.textContent = '🙈';
            } else {
                pwd.type = 'password';
                this.textContent = '👁️';
            }
        });
    </script>
</body>
</html>
