@page "/Login"
@model F8Urgentes.Dashboard.Pages.LoginModel
@{
    ViewData["Title"] = "Acceso - F8 Urgentes";
    Layout = null; // No usamos el layout principal porque queremos la pantalla completa para el login
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/f8-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tema-lico.css" asp-append-version="true" />
</head>
<body class="login-shell">
    <div class="login-card">
        <div class="brand">
            <span class="login-lico" data-lico="saluda" aria-hidden="true"></span>
            <img src="~/img/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="brand-logo" />
            <h2>F8 Urgentes</h2>
        </div>

        <h1>Acceso</h1>
        <p class="subtitle">Ingresa tus credenciales para continuar</p>

        <form method="post">
            @if (!ModelState.IsValid)
            {
                <div class="error">
                    Usuario o contraseña incorrectos.
                </div>
            }

            <div class="field">
                <label for="username-input">Usuario</label>
                <input type="text" asp-for="Username" id="username-input" placeholder="Ingresa tu usuario" required />
            </div>

            <div class="field">
                <label for="password-input">Contraseña</label>
                <div class="password-field">
                    <input type="password" asp-for="Password" id="password-input" placeholder="Ingresa tu contraseña" required />
                    <button type="button" id="toggle-password" class="password-toggle" aria-label="Mostrar contraseña">👁️</button>
                </div>
            </div>

            <button type="submit" class="btn-submit">Ingresar</button>

            <div class="login-links">
                <a href="/Recuperar">¿Olvidaste tu contraseña?</a>
                <a href="/Registro" class="register">Registrarse</a>
            </div>
        </form>
    </div>

    <script>
        document.getElementById('toggle-password').addEventListener('click', function () {
            var pwd = document.getElementById('password-input');
            if (pwd.type === 'password') {
                pwd.type = 'text';
                this.textContent = '🙈';
            } else {
                pwd.type = 'password';
                this.textContent = '👁️';
            }
        });
    </script>
    <script src="~/js/lico.js" asp-append-version="true"></script>
</body>
</html>
