@page
@model F8Urgentes.Dashboard.Pages.RecuperarModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/f8-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tema-lico.css" asp-append-version="true" />
</head>
<body class="login-shell recovery-shell">
    <div class="login-card">
        <span class="login-lico" data-lico="explica" aria-hidden="true"></span>
        <h1>Recuperar contraseña</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="recovery-message">@Model.Message</div>
            <a href="/Login">Volver al inicio de sesión</a>
        }
        else
        {
            <div asp-validation-summary="All" class="recovery-errors"></div>
            <form method="post">
                <label asp-for="Username">Usuario</label>
                <input asp-for="Username" autocomplete="username" placeholder="Ingresa tu nombre de usuario" />

                @if (!string.IsNullOrWhiteSpace(Model.PreguntaSecreta))
                {
                    <p class="recovery-question">Pregunta secreta: @Model.PreguntaSecreta</p>
                    <label asp-for="RespuestaSecreta">Respuesta Secreta</label>
                    <input asp-for="RespuestaSecreta" type="text" placeholder="Ingresa la respuesta secreta" />
                }
                else
                {
                    <label asp-for="RespuestaSecreta">Respuesta Secreta (si configuraste una)</label>
                    <input asp-for="RespuestaSecreta" type="text" placeholder="Respuesta a tu pregunta secreta" />
                }

                <label asp-for="NuevaPassword">Nueva contraseña</label>
                <input asp-for="NuevaPassword" type="password" autocomplete="new-password" placeholder="Mínimo 8 caracteres" />
                <label asp-for="ConfirmarPassword">Confirmar contraseña</label>
                <input asp-for="ConfirmarPassword" type="password" autocomplete="new-password" placeholder="Repite la nueva contraseña" />
                <button type="submit" class="btn-submit">Cambiar contraseña</button>
            </form>
            <div class="login-links login-links-centro">
                <a href="/Login">Volver al inicio de sesión</a>
            </div>
        }
    </div>
    <script src="~/js/lico.js" asp-append-version="true"></script>
</body>
</html>
