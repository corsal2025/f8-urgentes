@* Shared function bar for the secondary pages (Estadisticas, SectorF8, ImpresionMensual).
   Active item is derived from the current path (+ ?sector= for the two PDF queues). *@
@{
    var path = Context.Request.Path.Value ?? "";
    var sector = Context.Request.Query["sector"].ToString();
    bool Is(string p, string? s = null) =>
        path.Equals(p, StringComparison.OrdinalIgnoreCase) &&
        (s is null || sector.Equals(s, StringComparison.OrdinalIgnoreCase) || (s == "Archivo" && sector.Length == 0));

    var items = new[]
    {
        (Href: "/Index", Label: "Solicitudes", Hint: "Volver al listado", Tone: "tn-slate", Active: false,
            Icon: "<path d=\"M19 12H5\"/><polyline points=\"12 19 5 12 12 5\"/>"),
        (Href: "/SectorF8?sector=Archivo", Label: "PDF Archivo", Hint: "Cola de impresión", Tone: "tn-violet", Active: Is("/SectorF8", "Archivo"),
            Icon: "<path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"8\" y1=\"13\" x2=\"16\" y2=\"13\"/><line x1=\"8\" y1=\"17\" x2=\"13\" y2=\"17\"/>"),
        (Href: "/SectorF8?sector=Oficina43", Label: "PDF Oficina 43", Hint: "Cola de impresión", Tone: "tn-amber", Active: Is("/SectorF8", "Oficina43"),
            Icon: "<path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"8\" y1=\"13\" x2=\"16\" y2=\"13\"/><line x1=\"8\" y1=\"17\" x2=\"13\" y2=\"17\"/>"),
        (Href: "/Estadisticas", Label: "Estadísticas", Hint: "Indicadores y gráficos", Tone: "tn-teal", Active: Is("/Estadisticas"),
            Icon: "<line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"/><line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"/><line x1=\"6\" y1=\"20\" x2=\"6\" y2=\"14\"/><line x1=\"3\" y1=\"20\" x2=\"21\" y2=\"20\"/>"),
        (Href: "/ImpresionMensual", Label: "Impresión mensual", Hint: "Listado del mes", Tone: "tn-sky", Active: Is("/ImpresionMensual"),
            Icon: "<polyline points=\"6 9 6 2 18 2 18 9\"/><path d=\"M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2\"/><rect x=\"6\" y=\"14\" width=\"12\" height=\"8\"/>"),
        (Href: "/Caja", Label: "Caja", Hint: "Cajas físicas de carpetas", Tone: "tn-green", Active: Is("/Caja"),
            Icon: "<path d=\"M21 8v13H3V8\"/><path d=\"M1 3h22v5H1z\"/><line x1=\"10\" y1=\"12\" x2=\"14\" y2=\"12\"/>"),
    };
}
<nav class="tool-nav no-print" aria-label="Funciones">
    @foreach (var it in items)
    {
        <a href="@it.Href" class="tool-nav-item @it.Tone @(it.Active ? "is-active" : "")" aria-current="@(it.Active ? "page" : null)">
            <span class="tool-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(it.Icon)</svg>
            </span>
            <span class="tool-nav-text">
                <span class="tool-nav-label">@it.Label</span>
                <span class="tool-nav-hint">@it.Hint</span>
            </span>
        </a>
    }
</nav>
